def log(msg: str) -> None:
    print("[adv-proxy %s] %s" % (time.strftime("%H:%M:%S"), msg), flush=True)


# ══════════════════════════════════════════════════════════════
#  TUNING DE SOCKETS
# ══════════════════════════════════════════════════════════════
def tune_socket(writer: asyncio.StreamWriter) -> None:
    """TCP_NODELAY + keepalive + buffers de SO_SNDBUF/SO_RCVBUF."""
    try:
        sock = writer.get_extra_info("socket")
        if not sock:
            return
        # Sin Nagle: menor latencia en conexiones interactivas
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        # Buffers de kernel: más datos en vuelo = mayor throughput
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, SOCK_SNDBUF)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, SOCK_RCVBUF)
        if TCP_KEEPALIVE:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            if hasattr(socket, "TCP_KEEPIDLE"):
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, TCP_KEEPIDLE)
            if hasattr(socket, "TCP_KEEPINTVL"):
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, TCP_KEEPINTVL)
            if hasattr(socket, "TCP_KEEPCNT"):
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, TCP_KEEPCNT)
    except Exception:
        pass


def tune_writer_buffers(w: asyncio.StreamWriter) -> None:
    """Sube el high-watermark del StreamWriter para reducir drain() innecesarios.

    Con el límite por defecto (64 KB), asyncio pausa la escritura en cuanto
    el buffer interno supera ese valor.  Subirlo a 256 KB permite que el
    kernel agrupe más datos antes de pausar, reduciendo context-switches y
    mejorando throughput en sesiones de video/streaming.
    """
    try:
        w.transport.set_write_buffer_limits(high=WRITE_HIGH, low=WRITE_LOW)
    except Exception:
        pass


# ══════════════════════════════════════════════════════════════
#  DETECCIÓN DE PROTOCOLO
# ══════════════════════════════════════════════════════════════
def looks_tls(buf: bytes) -> bool:
    return len(buf) >= 3 and buf[0] == 0x16 and buf[1] == 0x03


def first_line(buf: bytes) -> bytes:
    if b"\r\n" in buf:
        return buf.split(b"\r\n", 1)[0]
    return buf.split(b"\n", 1)[0]


def is_connect_method(buf: bytes) -> bool:
    ln = first_line(buf).strip()
    if not ln:
        return False
    return ln.split(None, 1)[0].upper() == b"CONNECT"


def is_ssh_banner(buf: bytes) -> bool:
    return buf.startswith(b"SSH-2.0")


def _iter_header_lines(block: bytes):
    normalized = block.replace(b"\r\n", b"\n")
    for raw in normalized.split(b"\n"):
        yield raw


def header_value(block: bytes, name: bytes) -> bytes:
    nl = name.lower()
    for raw in _iter_header_lines(block):
        if b":" not in raw:
            continue
        k, _, v = raw.partition(b":")
        if k.strip().lower() == nl:
            return v.strip()
    return b""


def forced_connection_mode(buf: bytes) -> Optional[str]:
    if not buf:
        return None
    raw = header_value(buf, HDR_FORCE).decode("latin-1", "replace").strip().lower()
    if raw in ("ssh", "vless"):
        return raw
    return None


def is_upgrade_websocket(buf: bytes) -> bool:
    low = buf.lower()
    return b"upgrade:" in low and b"websocket" in low


def _inject_ws_upgrade(buf: bytes) -> bytes:
    """Reinserta Upgrade/Connection si CloudFront los stripeó (RFC 7230 §6.1)."""
    idx = buf.rfind(b"\r\n\r\n")
    if idx == -1:
        return buf
    headers, end = buf[:idx], buf[idx:]
    low = headers.lower()
    extra = b""
    if b"upgrade:" not in low:
        extra += b"\r\nUpgrade: websocket"
    if b"connection:" not in low:
        extra += b"\r\nConnection: Upgrade"
    return (headers + extra + end) if extra else buf


def _resolve_client_ip(buf: bytes, peer: object) -> str:
    """IP real: CF-Connecting-IP → X-Forwarded-For → X-Real-IP → peer TCP."""
    cf = header_value(buf, b"CF-Connecting-IP").decode("latin-1", "replace").strip()
    if cf:
        return cf.split(",")[0].strip()
    xff = header_value(buf, b"X-Forwarded-For").decode("latin-1", "replace").strip()
    if xff:
        return xff.split(",")[0].strip()
    xri = header_value(buf, b"X-Real-IP").decode("latin-1", "replace").strip()
    if xri:
        return xri.split(",")[0].strip()
    if peer and isinstance(peer, (tuple, list)) and peer:
        return str(peer[0])
    return "127.0.0.1"


def _inject_client_ip(buf: bytes, client_ip: str) -> bytes:
    """Reescribe IP headers y agrega X-Adv-Proxy (confianza Xray 26.6+)."""
    idx = buf.find(b"\r\n\r\n")
    if idx == -1:
        return buf
    headers = buf[:idx]
    rest = buf[idx:]
    ip_b = client_ip.encode("ascii", "replace")
    skip = (
        b"x-forwarded-for:",
        b"x-real-ip:",
        HDR_TRUST.lower() + b":",
    )
    lines = []
    for raw in headers.split(b"\r\n"):
        if not raw:
            continue
        if any(raw.lower().startswith(p) for p in skip):
            continue
        lines.append(raw)
    extra = (
        b"\r\nX-Real-IP: " + ip_b
        + b"\r\nX-Forwarded-For: " + ip_b
        + b"\r\n" + HDR_TRUST + b": 1"
    )
    return b"\r\n".join(lines) + extra + rest


def _rewrite_vless_path(buf: bytes, target_path: bytes = b"/VLESS") -> bytes:
    """Normaliza /VLESS-AR5, /VLESS-US1... → path exacto que Xray tiene configurado."""
    eol = buf.find(b"\r\n")
    if eol == -1:
        return buf
    first = buf[:eol]
    rest  = buf[eol:]
    parts = first.split(b" ", 2)
    if len(parts) < 2:
        return buf
    method    = parts[0]
    path_full = parts[1]
    proto     = parts[2] if len(parts) > 2 else b"HTTP/1.1"
    if b"?" in path_full:
        _, query = path_full.split(b"?", 1)
        new_path = target_path + b"?" + query
    else:
        new_path = target_path
    return method + b" " + new_path + b" " + proto + rest


def ws_accept_from_request(buf: bytes) -> str:
    key  = header_value(buf, b"Sec-WebSocket-Key")
    if not key:
        return "AnyValue"
    guid = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    return base64.b64encode(hashlib.sha1(key + guid).digest()).decode("ascii")


def ws_request_path(buf: bytes) -> bytes:
    """Request-target de la primera línea (sin query string)."""
    if b"\r\n" not in buf:
        return b""
    try:
        line0 = buf.split(b"\r\n", 1)[0]
        parts = line0.split()
        if len(parts) < 2:
            return b""
        return parts[1].split(b"?", 1)[0]
    except Exception:
        return b""


def is_ws_vless_path(buf: bytes) -> bool:
    """WebSocket VLESS si el path contiene 'vless' en cualquier posición."""
    if b"\r\n\r\n" not in buf:
        return False
    try:
        line0  = buf.split(b"\r\n", 1)[0].decode("latin-1", "replace")
        parts  = line0.split()
        if len(parts) < 2:
            return False
        method = parts[0].upper()
        if method not in ("GET", "CONNECT", "POST", "HEAD"):
            return False
        path = parts[1].split("?", 1)[0]
        return b"vless" in path.lower()
    except Exception:
        return False


def needs_local_http_handshake_for_ssh(buf: bytes) -> bool:
    if b"\r\n\r\n" not in buf:
        return False
    return is_connect_method(buf) or is_upgrade_websocket(buf)


def http_body_tail(buf: bytes) -> bytes:
    i = buf.find(b"\r\n\r\n")
    if i == -1:
        return b""
    return buf[i + 4:]


def request_path_first_segment(buf: bytes) -> Optional[str]:
    """Primer segmento del path (etiqueta). GET /, GET sin segmento, CONNECT → None."""
    if b"\r\n" not in buf:
        return None
    line0 = buf.split(b"\r\n", 1)[0].strip()
    parts = line0.split()
    if len(parts) < 2:
        return None
    if parts[0].upper() == b"CONNECT":
        return None
    raw = parts[1]
    if raw.startswith(b"http://") or raw.startswith(b"https://"):
        try:
            from urllib.parse import urlparse

            raw = urlparse(raw.decode("latin-1", "replace")).path.encode("latin-1", "replace")
        except Exception:
            return None
    path = raw.split(b"?", 1)[0]
    seg = path.strip(b"/").split(b"/", 1)[0]
    if not seg:
        return None
    return seg.decode("latin-1", "replace")


def resolve_ssh_backend(buf: bytes) -> Tuple[str, int]:
    """Etiqueta ausente o no listada → TARGET_SSH_IP:TARGET_SSH_PORT (local por defecto)."""
    tag = request_path_first_segment(buf)
    if tag is None or tag not in SSH_BACKENDS:
        return (TARGET_SSH_IP, TARGET_SSH_PORT)
    return SSH_BACKENDS[tag]


def split_http_messages(buf: bytes) -> Tuple[List[bytes], bytes]:
    """Separa peticiones HTTP completas (pipelining HTTP Custom)."""
    complete: List[bytes] = []
    pos = 0
    while pos < len(buf):
        idx = buf.find(b"\r\n\r\n", pos)
        if idx == -1:
            return complete, buf[pos:]
        end = idx + 4
        complete.append(buf[pos:end])
        pos = end
    return complete, b""


def _vless_tag_from_message(msg: bytes) -> Optional[str]:
    seg = request_path_first_segment(msg)
    if seg is not None and seg in VLESS_BACKENDS:
        return seg
    raw = ws_request_path(msg).decode("latin-1", "replace").lstrip("/").split("?", 1)[0]
    if raw and raw in VLESS_BACKENDS:
        return raw
    raw_lower = raw.lower()
    for key in sorted(VLESS_BACKENDS.keys(), key=len, reverse=True):
        kl = key.lower()
        if raw_lower == kl or kl in raw_lower:
            return key
    return None


def is_vless_ws_message(block: bytes) -> bool:
    """Una sola petición HTTP: upgrade WS con 'vless' en el path o etiqueta en VLESS_BACKENDS."""
    if b"\r\n\r\n" not in block:
        return False
    forced = forced_connection_mode(block)
    if forced == "ssh":
        return False
    if not is_upgrade_websocket(block):
        return False
    return is_ws_vless_path(block) or _vless_tag_from_message(block) is not None


def find_vless_ws_message(messages: List[bytes]) -> Optional[bytes]:
    for msg in reversed(messages):
        if is_vless_ws_message(msg):
            return msg
    return None


def has_vless_ws_in_buf(buf: bytes) -> bool:
    if b"\r\n\r\n" not in buf:
        return False
    messages, _ = split_http_messages(buf)
    return find_vless_ws_message(messages) is not None


def vless_backend_tag(buf: bytes) -> Optional[str]:
    """Clave de VLESS_BACKENDS (escanea pipelining; usa el mensaje WS VLESS)."""
    messages, _ = split_http_messages(buf)
    ws_msg = find_vless_ws_message(messages)
    if ws_msg:
        tag = _vless_tag_from_message(ws_msg)
        if tag:
            return tag
    return _vless_tag_from_message(buf)


def path_tag_in_vless_backends(buf: bytes) -> bool:
    return vless_backend_tag(buf) is not None


def resolve_vless_backend(buf: bytes) -> Tuple[str, int, str]:
    """Etiqueta ausente o no listada → TARGET_VLESS_* (local por defecto, como antes)."""
    messages, _ = split_http_messages(buf)
    ws_msg = find_vless_ws_message(messages) or buf
    tag = _vless_tag_from_message(ws_msg)
    if tag is None:
        return (TARGET_VLESS_IP, TARGET_VLESS_PORT, TARGET_VLESS_PATH)
    ip, port, path = VLESS_BACKENDS[tag]
    return (ip, port, path)


def http_403() -> bytes:
    return (
        b"HTTP/1.1 403 Forbidden\r\n"
        b"Content-Length: 0\r\n"
        b"Connection: keep-alive\r\n"
        b"Server: nginx/1.24.0\r\n\r\n"
    )


async def read_http_headers(reader: asyncio.StreamReader, timeout: float = 20.0) -> bytes:
    buf = b""
    deadline = time.time() + timeout
    while time.time() < deadline:
        idx = buf.find(b"\r\n\r\n")
        if idx != -1:
            return buf[: idx + 4]
        try:
            chunk = await asyncio.wait_for(reader.read(8192), timeout=5.0)
        except asyncio.TimeoutError:
            continue
        if not chunk:
            break
        buf += chunk
    return buf


def classify(buf: bytes) -> Optional[str]:
    if not buf:
        return None
    if looks_tls(buf):
        return "tls"
    if is_ssh_banner(buf):
        return "ssh"
    if is_connect_method(buf):
        return "ssh"
    if b"\r\n\r\n" in buf:
        forced = forced_connection_mode(buf)
        if forced == "ssh":
            return "ssh"
        # No clasificar VLESS solo por X-Adv-Connection en GET / (probe HTTP Custom).
        if has_vless_ws_in_buf(buf):
            return "vless"
        if is_ws_vless_path(buf):
            return "vless"
        if is_upgrade_websocket(buf) and path_tag_in_vless_backends(buf):
            return "vless"
        return "ssh"
    if len(buf) >= 8:
        fl = first_line(buf)
        if fl.startswith(b"GET ") or fl.startswith(b"POST ") or fl.startswith(b"HEAD "):
            return None
    return None


def pipeline_awaiting_more(buf: bytes) -> bool:
    """HTTP Custom [split]: no cerrar peek en GET / o REDLIBRE si puede venir el WS después."""
    if has_vless_ws_in_buf(buf):
        return False
    messages, remainder = split_http_messages(buf)
    if remainder:
        return True
    if not messages:
        return False
    for msg in messages:
        if is_upgrade_websocket(msg):
            # WS sin vless en path (/REDLIBRE…): puede seguir el bloque VLESS real.
            if is_vless_ws_message(msg):
                return False
            return True
    return True


PIPELINE_PEEK_TIMEOUT = 5.0
DEFAULT_PEEK_TIMEOUT = 2.0


# ══════════════════════════════════════════════════════════════
#  RELAY CORE
# ══════════════════════════════════════════════════════════════
async def peek_loop(reader: asyncio.StreamReader) -> Tuple[bytes, str]:
    buf = b""
    while len(buf) < MAX_PEEK:
        k = classify(buf)
        if k == "tls":
            return buf, "tls"
        if k == "vless":
            return buf, k
        if k == "ssh" and not pipeline_awaiting_more(buf):
            return buf, k
        peek_timeout = (
            PIPELINE_PEEK_TIMEOUT if pipeline_awaiting_more(buf) else DEFAULT_PEEK_TIMEOUT
        )
        try:
            chunk = await asyncio.wait_for(reader.read(8192), timeout=peek_timeout)
        except asyncio.TimeoutError:
            if classify(buf) == "ssh" and not pipeline_awaiting_more(buf):
                return buf, "ssh"
            if has_vless_ws_in_buf(buf):
                return buf, "vless"
            break
        if not chunk:
            break
        buf += chunk
        k = classify(buf)
        if k == "tls":
            return buf, "tls"
        if k == "vless":
            return buf, k
        if k == "ssh" and not pipeline_awaiting_more(buf):
            return buf, k
    k2 = classify(buf)
    if k2 == "vless" or has_vless_ws_in_buf(buf):
        return buf, "vless"
    if k2 == "ssh" and not pipeline_awaiting_more(buf):
        return buf, k2
    if looks_tls(buf):
        return buf, "tls"
    if pipeline_awaiting_more(buf):
        msgs, rem = split_http_messages(buf)
        paths = []
        for m in msgs[:4]:
            p = ws_request_path(m).decode("latin-1", "replace") or "?"
            paths.append(p)
        log(
            "peer peek incompleto (%d B, %d msg, paths=%s, rem=%d B) — esperaba más pipelining HTTP"
            % (len(buf), len(msgs), ",".join(paths), len(rem))
        )
    return buf, "ssh"


async def half_duplex(
    src: asyncio.StreamReader,
    dst: asyncio.StreamWriter,
    label: str,
) -> None:
    """Copia datos src→dst sin drain() innecesario.

    Con write_buffer_limits(high=WRITE_HIGH), asyncio pausa automáticamente
    cuando el buffer interno supera el umbral.  Llamar drain() solo cuando
    hay back-pressure real elimina miles de context-switches por sesión.
    """
    try:
        while True:
            data = await src.read(CHUNK)
            if not data:
                break
            dst.write(data)
            # drain() solo si el buffer de escritura supera el high-watermark
            if dst.transport.get_write_buffer_size() > WRITE_HIGH:
                await dst.drain()
    except asyncio.CancelledError:
        raise
    except Exception as ex:
        log("half %s: %s" % (label, ex))


async def transparent_relay(
    client_r: asyncio.StreamReader,
    client_w: asyncio.StreamWriter,
    peek_buf: bytes,
    host: str,
    port: int,
    peer: object,
    kind: str,
    vless_upstream_path: Optional[bytes] = None,
) -> None:
    started = time.time()
    up_w: Optional[asyncio.StreamWriter] = None
    up_r: Optional[asyncio.StreamReader] = None
    try:
        try:
            up_r, up_w = await asyncio.wait_for(
                asyncio.open_connection(host, port), timeout=20.0
            )
        except Exception as ex:
            log("peer=%r %s backend %s:%s fallo: %s" % (peer, kind, host, port, ex))
            return

        tune_socket(client_w)
        tune_socket(up_w)
        tune_writer_buffers(client_w)
        tune_writer_buffers(up_w)

        if peek_buf:
            if kind == "vless":
                client_ip = _resolve_client_ip(peek_buf, peer)
                up_path = (
                    vless_upstream_path
                    if vless_upstream_path is not None
                    else TARGET_VLESS_PATH.encode("utf-8")
                )
                send_buf = _rewrite_vless_path(
                    _inject_client_ip(_inject_ws_upgrade(peek_buf), client_ip),
                    up_path,
                )
            else:
                send_buf = peek_buf
            up_w.write(send_buf)
            await up_w.drain()

        t_c2u = asyncio.create_task(half_duplex(client_r, up_w, "c→up"))
        t_u2c = asyncio.create_task(half_duplex(up_r, client_w, "up→c"))
        try:
            _done, pending = await asyncio.wait(
                {t_c2u, t_u2c}, return_when=asyncio.FIRST_COMPLETED
            )
            for t in pending:
                t.cancel()
            if pending:
                await asyncio.gather(*pending, return_exceptions=True)
        except asyncio.CancelledError:
            for t in (t_c2u, t_u2c):
                if not t.done():
                    t.cancel()
            await asyncio.gather(t_c2u, t_u2c, return_exceptions=True)
            raise

    except asyncio.CancelledError:
        raise
    finally:
        elapsed_ms = int((time.time() - started) * 1000)
        log("peer=%r fin %s (%d ms)" % (peer, kind, elapsed_ms))
        for w in [w for w in [up_w, client_w] if w is not None]:
            try:
                w.close()
            except Exception:
                pass
        for w in [w for w in [up_w, client_w] if w is not None]:
            try:
                await asyncio.shield(w.wait_closed())
            except Exception:
                pass


async def handle_vless_pipeline(
    client_r: asyncio.StreamReader,
    client_w: asyncio.StreamWriter,
    peek_buf: bytes,
    peer: object,
) -> None:
    """HTTP Custom con [split]: 403 a basura + 101 de Xray solo al mensaje WS VLESS."""
    messages, _ = split_http_messages(peek_buf)
    ws_msg = find_vless_ws_message(messages)
    if not ws_msg:
        log("peer=%r vless-pipe sin WS en buffer" % (peer,))
        return

    junk = [m for m in messages if m is not ws_msg]
    vh, vp, vpth = resolve_vless_backend(ws_msg)
    vtag = vless_backend_tag(ws_msg) or ws_request_path(ws_msg).decode(
        "latin-1", "replace"
    ).lstrip("/")
    log("peer=%r vless-pipe path=/%s %d×junk → %s:%s%s"
        % (peer, vtag, len(junk), vh, vp, vpth))

    for _ in junk:
        client_w.write(http_403())
    if junk:
        await client_w.drain()

    up_r: Optional[asyncio.StreamReader] = None
    up_w: Optional[asyncio.StreamWriter] = None
    try:
        up_r, up_w = await asyncio.wait_for(
            asyncio.open_connection(vh, vp), timeout=20.0
        )
        tune_socket(client_w)
        tune_socket(up_w)
        tune_writer_buffers(client_w)
        tune_writer_buffers(up_w)

        client_ip = _resolve_client_ip(ws_msg, peer)
        xray_req = _rewrite_vless_path(
            _inject_client_ip(_inject_ws_upgrade(ws_msg), client_ip),
            vpth.encode("utf-8"),
        )
        up_w.write(xray_req)
        await up_w.drain()

        up_headers = await read_http_headers(up_r)
        if not up_headers or b"101" not in up_headers.split(b"\r\n", 1)[0]:
            status = up_headers.split(b"\r\n", 1)[0] if up_headers else b"(vacio)"
            log("peer=%r vless-pipe Xray no 101: %r" % (peer, status))
            client_w.write(http_403())
            await client_w.drain()
            return

        client_w.write(up_headers)
        await client_w.drain()
        log("peer=%r vless-pipe 101 → relay WS" % (peer,))

        t_c2u = asyncio.create_task(half_duplex(client_r, up_w, "c→up"))
        t_u2c = asyncio.create_task(half_duplex(up_r, client_w, "up→c"))
        try:
            _done, pending = await asyncio.wait(
                {t_c2u, t_u2c}, return_when=asyncio.FIRST_COMPLETED
            )
            for t in pending:
                t.cancel()
            if pending:
                await asyncio.gather(*pending, return_exceptions=True)
        except asyncio.CancelledError:
            for t in (t_c2u, t_u2c):
                if not t.done():
                    t.cancel()
            await asyncio.gather(t_c2u, t_u2c, return_exceptions=True)
            raise
    except asyncio.CancelledError:
        raise
    except Exception as ex:
        log("peer=%r vless-pipe error: %s" % (peer, ex))
    finally:
        for w in (up_w, client_w):
            if w is not None:
                try:
                    w.close()
                except Exception:
                    pass


async def handle_client(
    client_r: asyncio.StreamReader,
    client_w: asyncio.StreamWriter,
) -> None:
    global _active, _total
    peer = client_w.get_extra_info("peername")

    # ── Cupo: espera antes de rechazar (picos; muchas conexiones por usuario CDN) ─
    try:
        await asyncio.wait_for(_sem.acquire(), timeout=QUEUE_WAIT_TIMEOUT)
    except asyncio.TimeoutError:
        log("peer=%r sin cupo tras %.0fs (MAX_CONN=%d); rechazando"
            % (peer, QUEUE_WAIT_TIMEOUT, MAX_CONN))
        try:
            client_w.close()
            await asyncio.shield(client_w.wait_closed())
        except Exception:
            pass
        return

    _active += 1
    _total += 1
    try:
        peek_buf, kind = await peek_loop(client_r)
        if kind == "tls":
            try:
                client_w.close()
                await asyncio.shield(client_w.wait_closed())
            except Exception:
                pass
            return

        if kind == "vless":
            messages, _ = split_http_messages(peek_buf)
            ws_msg = find_vless_ws_message(messages)
            if ws_msg and len(messages) > 1:
                await handle_vless_pipeline(client_r, client_w, peek_buf, peer)
                return
            vh, vp, vpth = resolve_vless_backend(peek_buf)
            vtag = vless_backend_tag(peek_buf) or ws_request_path(peek_buf).decode(
                "latin-1", "replace"
            ).lstrip("/")
            log("peer=%r vless path=/%s → %s:%s%s" % (peer, vtag, vh, vp, vpth))
            await transparent_relay(
                client_r, client_w, peek_buf,
                vh, vp, peer, "vless",
                vless_upstream_path=vpth.encode("utf-8"),
            )
            return

        if needs_local_http_handshake_for_ssh(peek_buf):
            ssh_host, ssh_port = resolve_ssh_backend(peek_buf)
            if is_upgrade_websocket(peek_buf):
                accept = ws_accept_from_request(peek_buf)
                resp = (
                    "HTTP/1.1 101 Switching Protocols\r\n"
                    "Upgrade: websocket\r\n"
                    "Connection: Upgrade\r\n"
                    "Sec-WebSocket-Accept: %s\r\n"
                    "Server: nginx/1.24.0\r\n\r\n" % accept
                ).encode("latin-1")
            else:
                resp = (
                    "HTTP/1.1 200 Connection established\r\n"
                    "Proxy-Agent: adv-proxy-ws\r\n\r\n"
                ).encode("latin-1")
            client_w.write(resp)
            await client_w.drain()
            tail = http_body_tail(peek_buf)
            await transparent_relay(
                client_r, client_w, tail,
                ssh_host, ssh_port, peer, "ssh-http",
            )
            return

        ssh_host, ssh_port = resolve_ssh_backend(peek_buf)
        await transparent_relay(
            client_r, client_w, peek_buf,
            ssh_host, ssh_port, peer, "ssh",
        )
    except asyncio.CancelledError:
        raise
    except Exception as ex:
        log("peer=%r error: %s: %r" % (peer, type(ex).__name__, ex))
    finally:
        _active -= 1
        _sem.release()
        # No llamar gc.collect() aquí: durante GeneratorExit provoca
        # RuntimeError: coroutine ignored GeneratorExit (ver ram_clean).
        try:
            client_w.close()
            await asyncio.shield(client_w.wait_closed())
        except Exception:
            pass


# ══════════════════════════════════════════════════════════════
#  TAREAS DE MANTENIMIENTO
# ══════════════════════════════════════════════════════════════
async def ram_clean() -> None:
    """GC periódico en tarea de fondo (nunca en finally de handle_client)."""
    while True:
        await asyncio.sleep(RAM_CLEAN_SEC)
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(None, gc.collect)


async def stats_reporter() -> None:
    """Imprime sesiones activas/totales periódicamente."""
    while True:
        await asyncio.sleep(STATS_SEC)
        log("stats: activas=%d/%d  totales=%d  loop=%s"
            % (_active, MAX_CONN, _total, _LOOP_NAME))


# ══════════════════════════════════════════════════════════════
#  ARRANQUE
# ══════════════════════════════════════════════════════════════
async def main() -> None:
    global _sem
    _sem = asyncio.Semaphore(MAX_CONN)

    asyncio.create_task(ram_clean())
    asyncio.create_task(stats_reporter())

    servers = []
    for p in BIND_PORTS:
        s = await asyncio.start_server(
            handle_client,
            BIND_HOST,
            p,
            backlog=SERVER_BACKLOG,       # cola de accept() más grande
            reuse_port=True,              # SO_REUSEPORT: balance entre workers
        )
        servers.append(s)
        log("escuchando %s:%s  (backlog=%d  max_conn=%d  loop=%s)"
            % (BIND_HOST, p, SERVER_BACKLOG, MAX_CONN, _LOOP_NAME))

    back_list = ", ".join(
        "%s→%s:%s" % (k, h, p) for k, (h, p) in sorted(SSH_BACKENDS.items())
    )
    vless_list = ", ".join(
        "%s→%s:%s%s" % (k, h, p, path)
        for k, (h, p, path) in sorted(VLESS_BACKENDS.items())
    )
    log("SSH default %s:%s [%s]"
        % (TARGET_SSH_IP, TARGET_SSH_PORT, back_list or "sin etiquetas"))
    log("VLESS default %s:%s%s [%s] | forzar %s: ssh|vless"
        % (TARGET_VLESS_IP, TARGET_VLESS_PORT, TARGET_VLESS_PATH,
           vless_list or "sin etiquetas por path", HDR_FORCE.decode()))
    log("Xray Sockopt: trustedXForwardedFor = [%s]" % HDR_TRUST.decode())

    await asyncio.gather(*[s.serve_forever() for s in servers])


if __name__ == "__main__":
    if sys.version_info < (3, 7):
        print("Python 3.7+ requerido", file=sys.stderr)
        sys.exit(1)
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
