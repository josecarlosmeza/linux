# ══════════════════════════════════════════════════════════════
#  CONFIGURACIÓN
# ══════════════════════════════════════════════════════════════
BIND_HOST = "0.0.0.0"
BIND_PORTS = [80]

TARGET_SSH_IP   = "127.0.0.1"
TARGET_SSH_PORT = 22

TARGET_VLESS_IP   = "127.0.0.1"
TARGET_VLESS_PORT = 10000
TARGET_VLESS_PATH = "/VLESS"

HDR_FORCE = b"X-Adv-Connection"   # ssh | vless
HDR_TRUST = b"X-Adv-Proxy"         # sello para Xray sockopt.trustedXForwardedFor

# Etiqueta en el path HTTP → backend SSH (IP, puerto).
# Solo aplica si el primer segmento del path coincide con una clave (p. ej. /REDLIBRE).
# Sin etiqueta: path / o vacío, CONNECT, banner SSH directo, o clave desconocida →
# siempre TARGET_SSH_IP:TARGET_SSH_PORT (comportamiento original).
# Los nombres son sensibles a mayúsculas/minúsculas tal como en el diccionario.
SSH_BACKENDS: Dict[str, Tuple[str, int]] = {
    "REDLIBRE": ("127.0.0.1", 22),
    # "OTRO": ("10.0.0.2", 2222),
}

# Etiqueta en el path (WebSocket) → backend VLESS (IP, puerto, path en Xray).
# Cualquier path que contenga "vless" (/VLESS, /dedicado-VP03-vless…) se trata como VLESS.
# Si el primer segmento o la etiqueta completa coincide con una clave → ese backend.
# Si no hay clave en el diccionario → TARGET_VLESS_IP:TARGET_VLESS_PORT y TARGET_VLESS_PATH.
# Misma etiqueta en SSH y VLESS: por defecto gana VLESS en WS (usar X-Adv-Connection: ssh para forzar SSH).
VLESS_BACKENDS: Dict[str, Tuple[str, int, str]] = {
    "REDLIBRE": ("127.0.0.1", 10000, "/VLESS"),
    # "US1": ("10.0.0.3", 10000, "/VLESS"),
}

# ── Relay ─────────────────────────────────────────────────────
CHUNK          = 32768     # 32 KB: balance entre latencia y throughput
WRITE_HIGH     = 262144    # 256 KB: umbral para activar back-pressure
WRITE_LOW      = 65536     # 64 KB: umbral para reanudar escritura

# ── Concurrencia ──────────────────────────────────────────────
# Subir según carga: cada usuario puede abrir docenas de conexiones (HTTP/3→TCP + tabs).
MAX_CONN       = 10000      # sesiones asyncio simultáneas (antes 600 rechazaba pronto)
SERVER_BACKLOG = 65535      # cola listen() Linux (valor alto; sysctl somaxconn ya elevado)

# Espera antes de rechazar si [MAX_CONN] está lleno (evita "rechazo duro" en picos cortos).
QUEUE_WAIT_TIMEOUT = 300.0   # segundos

# ── Peek ──────────────────────────────────────────────────────
MAX_PEEK = 65536

# ── Keepalive TCP ─────────────────────────────────────────────
TCP_KEEPALIVE = True
TCP_KEEPIDLE  = 60
TCP_KEEPINTVL = 10
TCP_KEEPCNT   = 3

# ── Buffers de socket ─────────────────────────────────────────
SOCK_SNDBUF = 131072       # 128 KB por socket de escritura
SOCK_RCVBUF = 131072       # 128 KB por socket de lectura

# ── Mantenimiento ─────────────────────────────────────────────
RAM_CLEAN_SEC  = 60        # GC cada 60 s (más frecuente bajo carga)
STATS_SEC      = 30        # imprimir estadísticas cada 30 s

# ── Estado global ─────────────────────────────────────────────
_sem: asyncio.Semaphore    # inicializado en main()
_active: int = 0           # contador de sesiones activas
_total:  int = 0           # total de sesiones desde inicio

# ══════════════════════════════════════════════════════════════
#  LOG
