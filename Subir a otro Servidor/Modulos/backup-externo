	_pause
}

_run_now() {
	clear; _line
	echo -e "\E[44;1;37m        Respaldar ahora        \E[0m"; _line
	_run 2>&1 | tee -a "$LOG"
	echo ""
	_show_status
	_pause
}

# --- restauración ------------------------------------------------------------
_pick() { # _pick "titulo" lista(archivo con nombres)  → _PICKED
	local -a arr=()
	mapfile -t arr <"$2"
	((${#arr[@]})) || { _err "No hay respaldos para elegir."; return 1; }
	local i
	echo -e "\033[1;33m$1\033[0m"
	for i in "${!arr[@]}"; do
		printf '  \033[1;31m[\033[1;36m%2d\033[1;31m]\033[1;37m %s\n' "$((i + 1))" "${arr[$i]}"
	done
	echo -ne "\033[1;32mNúmero (0 = cancelar): \033[1;37m"
	read -r i
	[[ "$i" =~ ^[0-9]+$ && "$i" -ge 1 && "$i" -le ${#arr[@]} ]] || return 1
	_PICKED="${arr[$((i - 1))]}"
}

_restore() {
	_load
	clear; _line
	echo -e "\E[44;1;37m        Restaurar desde un respaldo        \E[0m"; _line
	echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mCopia local (este servidor)"
	echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mDesde el VPS por SSH"
	echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mDesde la nube (rclone)"
	echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;37m• \033[1;33mArchivo .tar.enc que ya copié a este servidor"
	echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mVolver"
	echo -ne "\033[1;32mOrigen: \033[1;37m"
	local o f="" tmp lst pw pf work
	read -r o
	umask 077
	mkdir -p "$LOCAL_DIR/restore"; chmod 700 "$LOCAL_DIR" "$LOCAL_DIR/restore"
	lst="$(mktemp)"
	case "$o" in
	1)
		ls -1 "$LOCAL_DIR"/rl-*.tar.enc 2>/dev/null | xargs -r -n1 basename | sort -r >"$lst"
		_pick "Copias locales:" "$lst" || { rm -f "$lst"; _pause; return; }
		f="$LOCAL_DIR/$_PICKED"
		;;
	2)
		[[ "$SSH_ON" = 1 || -n "$SSH_HOST" ]] || { _err "Configure primero el destino SSH."; rm -f "$lst"; _pause; return; }
		_ssh_list | grep -E '^rl-.*\.tar\.enc$' | sort -r | head -n 40 >"$lst"
		_pick "Respaldos en el VPS (más nuevos primero):" "$lst" || { rm -f "$lst"; _pause; return; }
		f="$LOCAL_DIR/restore/$_PICKED"
		_ssh_get "$_PICKED" "$f" || { _err "Falló la descarga."; rm -f "$lst" "$f"; _pause; return; }
		;;
	3)
		[[ -n "$RC_REMOTE" ]] || { _err "Configure primero la nube."; rm -f "$lst"; _pause; return; }
		_rc_list | grep -E '^rl-.*\.tar\.enc$' | sort -r | head -n 40 >"$lst"
		_pick "Respaldos en la nube (más nuevos primero):" "$lst" || { rm -f "$lst"; _pause; return; }
		f="$LOCAL_DIR/restore/$_PICKED"
		_rc_get "$_PICKED" "$f" || { _err "Falló la descarga."; rm -f "$lst" "$f"; _pause; return; }
		;;
	4)
		_ask f "Ruta completa del archivo" ""
		;;
	*) rm -f "$lst"; return ;;
	esac
	rm -f "$lst"
	[[ -s "$f" ]] || { _err "Archivo no encontrado o vacío: $f"; _pause; return; }

	pf="$(mktemp)"
	if [[ -s "$PASSF" ]] && _yes "¿Usar la contraseña guardada en este servidor?" s; then
		cp -f "$PASSF" "$pf"
	else
		echo -ne "\033[1;32mContraseña del respaldo: \033[1;37m"
		read -rs pw; echo
		printf '%s\n' "$pw" >"$pf"
	fi
	work="$(mktemp -d /var/tmp/rlrest.XXXXXX)"
	if ! _ossl_dec "$f" "$work/pack.tar" "$pf"; then
		_err "No se pudo descifrar: contraseña incorrecta o archivo dañado."
		rm -rf "$work" "$pf"; _pause; return
	fi
	rm -f "$pf"
	tar -C "$work" -xf "$work/pack.tar" 2>/dev/null
	echo ""
	_ok "Respaldo descifrado correctamente."
	echo -e "\033[1;33mContenido (MANIFEST):\033[0m"
	head -n 12 "$work/MANIFEST.txt" 2>/dev/null
	echo ""
	echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mUsuarios SSH, contraseñas, revendedores y bot (backup.vps)"
	echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mConfiguración extra (nodos/WireGuard, HCR, Xray, certificados, sshd)"
	echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mTodo"
	echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mCancelar"
	echo -ne "\033[1;32mQué restaurar: \033[1;37m"
	read -r o
	[[ "$o" =~ ^[123]$ ]] || { rm -rf "$work"; return; }
	_err "Esto SOBREESCRIBE archivos del sistema (usuarios, shadow, configuraciones)."
	echo -ne "\033[1;32mEscriba RESTAURAR para continuar: \033[1;37m"
	read -r pw
	[[ "$pw" = "RESTAURAR" ]] || { _warn "Cancelado."; rm -rf "$work"; _pause; return; }

	if [[ "$o" = 1 || "$o" = 3 ]]; then
		if [[ -s "$work/backup.vps" ]]; then
			cp -f "$work/backup.vps" /backup.vps
			( cd / && tar -xf backup.vps )
			rm -f /backup.vps
			[[ -x /bin/vence-migrar ]] && /bin/vence-migrar --quiet 2>/dev/null
			mkdir -p /etc/RedLibre/senha /etc/RedLibre/vence /etc/RedLibre/revendedores 2>/dev/null
			[[ -f /etc/sudoers.d/redlibre-revendedores ]] && chmod 440 /etc/sudoers.d/redlibre-revendedores
			if [[ -x /bin/gestor-revendedores ]] && grep -q -- '--after-restore' /bin/gestor-revendedores 2>/dev/null; then
				/bin/gestor-revendedores --after-restore >/dev/null 2>&1
			else
				[[ -x /bin/revendedor-sshd-lock ]] && /bin/revendedor-sshd-lock >/dev/null 2>&1
				[[ -x /bin/revendedor-caducidad-apply ]] && /bin/revendedor-caducidad-apply >/dev/null 2>&1
			fi
			_ok "Usuarios, revendedores y bot restaurados."
		else
			_err "El respaldo no trae backup.vps."
		fi
	fi
	if [[ "$o" = 2 || "$o" = 3 ]]; then
		if [[ -s "$work/extras.tar.gz" ]]; then
			tar -C / -xzf "$work/extras.tar.gz" 2>/dev/null
			command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload >/dev/null 2>&1
			cp -f "$work/crontab.txt" /root/crontab.restaurado.txt 2>/dev/null
			_ok "Configuración extra restaurada."
			_warn "Crontab guardado en /root/crontab.restaurado.txt (no se aplicó solo; revíselo)."
			if [[ -f /etc/RedLibre/nodos/enabled && -x /bin/gestor-nodos-salida ]]; then
				_warn "Reaplicando nodos de salida..."
				/bin/gestor-nodos-salida apply >/dev/null 2>&1
			fi
			if [[ -f /etc/RedLibre/hcr.conf && -x /opt/hcr-server/install.sh ]]; then
				_warn "HCR: abra el menú 32 → opción 2 para reaplicar el servicio."
			fi
			_warn "sshd/Xray: reinicie los servicios (menú 23) si cambió su configuración."
		else
			_err "El respaldo no trae configuración extra."
		fi
	fi
	rm -rf "$work"
	_pause
}

# --- reseña ------------------------------------------------------------------
_guia() {
	clear; _line
	echo -e "\E[44;1;37m        Reseña: backup externo diario        \E[0m"; _line
	cat <<'EOF'
QUÉ HACE
  Todos los días crea un respaldo (usuarios, revendedores, bot, nodos/WireGuard,
  HCR, Xray, certificados, sshd), lo CIFRA con AES-256 y lo sube a los destinos
  que active. Si un destino falla, avisa por Telegram.

PASOS (en este orden)
  2) Contraseña de cifrado. Guárdela además en un gestor de contraseñas.
  3) VPS por SSH: otro servidor (mejor otro proveedor). Crea una clave exclusiva.
  4) Nube con rclone: Cloudflare R2 / Backblaze B2 / Wasabi / Google Drive.
        R2: Cloudflare → R2 → crear bucket y "API token" (S3). En rclone config:
            tipo s3, proveedor Cloudflare, endpoint https://<cuenta>.r2.cloudflarestorage.com
        B2: crear bucket y "Application Key"; tipo b2.
        Ideal: clave de aplicación sin permiso de borrado (si hackean el servidor,
        no pueden destruir los respaldos). Con eso, la retención no podrá borrar
        los viejos desde acá: use la regla de ciclo de vida del bucket.
  5) Telegram: usa el bot del menú 25 (detecta token y chat solo).
  6) Programar: hora diaria y cuántos respaldos conservar.
  8) Probar destinos y 7) Respaldar ahora. Luego verifique con 9) una restauración.

RETENCIÓN
  Se conservan N diarios + 1 por semana durante M semanas. Los respaldos de cada
  servidor llevan el nombre rl-<host>-<fecha>-<hora>.tar.enc y solo se borran
  los de ese mismo host.

RESTAURAR EN UN SERVIDOR NUEVO
  1. Instale el panel RedLibre.   2. Menú 15 → 3.
  3. Configure el MISMO destino de antes (opción 3 o 4) para poder leerlo.
  4. Opción 9 (Restaurar): elija el origen (VPS/nube), escriba la contraseña
     del respaldo y elija qué restaurar. Los nodos se reaplican solos;
     HCR: menú 32 → 2.
     (Alternativa: copie el .tar.enc al servidor y use el origen 4.)

LIMITACIÓN
  Si el servidor se cae por completo, no puede avisar que "no llegó" el respaldo.
  Revise de vez en cuando la fecha del último respaldo en el destino, o use un
  monitor externo (por ejemplo un ping/heartbeat de healthchecks.io).

ARCHIVOS
  /etc/RedLibre/backup-externo.conf    configuración (solo root)
  /etc/RedLibre/.backup-externo.pass   contraseña de cifrado (solo root)
  /etc/RedLibre/.backup-externo.key    clave SSH del destino
  /var/backups/redlibre/               copias locales y descargas de restauración
  /var/log/redlibre-backup-externo.log registro
  /etc/cron.d/redlibre-backup-externo  tarea diaria
EOF
	echo ""
	_pause
}

_view_log() {
	clear
	[[ -f "$LOG" ]] && tail -n 60 "$LOG" || _warn "Aún no hay registro."
	echo ""
	_pause
}

# --- entrada -----------------------------------------------------------------
case "${1:-}" in
--run)
	_run
	exit $?
	;;
--status)
	_show_status
	exit 0
	;;
esac

_need_pkg openssl openssl >/dev/null 2>&1
mkdir -p "$LOCAL_DIR" 2>/dev/null; chmod 700 "$LOCAL_DIR" 2>/dev/null

while true; do
	clear
	_load
	_line
	echo -e "\E[44;1;37m        BACKUP EXTERNO DIARIO (cifrado)        \E[0m"
	_line
	_show_status
	_line
	echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mReseña de uso"
	echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mContraseña de cifrado"
	echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mDestino: otro VPS por SSH"
	echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;37m• \033[1;33mDestino: nube (rclone)"
	echo -e "\033[1;31m[\033[1;36m5\033[1;31m] \033[1;37m• \033[1;33mDestino: Telegram"
	echo -e "\033[1;31m[\033[1;36m6\033[1;31m] \033[1;37m• \033[1;33mProgramar diario / retención"
	echo -e "\033[1;31m[\033[1;36m7\033[1;31m] \033[1;37m• \033[1;33mRespaldar AHORA"
	echo -e "\033[1;31m[\033[1;36m8\033[1;31m] \033[1;37m• \033[1;33mProbar destinos"
	echo -e "\033[1;31m[\033[1;36m9\033[1;31m] \033[1;37m• \033[1;33mRestaurar"
	echo -e "\033[1;31m[\033[1;36m10\033[1;31m] \033[1;37m• \033[1;33mVer registro"
	echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mVolver"
	echo ""
	echo -ne "\033[1;32mOpción: \033[1;37m"
	read -r op
	case "$op" in
	1) _guia ;;
	2) _cfg_pass ;;
	3) _cfg_ssh ;;
	4) _cfg_rclone ;;
	5) _cfg_tg ;;
	6) _cfg_sched ;;
	7)
		if [[ ! -s "$PASSF" ]]; then _err "Primero configure la contraseña (opción 2)."; _pause; else _run_now; fi
		;;
	8) _test_dests ;;
	9) _restore ;;
	10) _view_log ;;
	0 | 00) exit 0 ;;
	*) _err "Opción no válida."; sleep 1 ;;
	esac
done
