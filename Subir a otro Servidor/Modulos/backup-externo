#!/bin/bash
#====================================================
# Backup externo diario y cifrado
# Menú 15 (BACKUP) → opción 3
# Destinos: VPS por SSH · nube (rclone) · Telegram
# CLI: --run (cron) | --status | (sin argumentos: menú)
#====================================================
set +e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin${PATH:+:$PATH}"
[[ $EUID -eq 0 ]] || { echo -e "\033[1;31mEjecute como root.\033[0m"; exit 1; }

CDIR="/etc/RedLibre"
CFG="$CDIR/backup-externo.conf"
PASSF="$CDIR/.backup-externo.pass"
SSHKEY="$CDIR/.backup-externo.key"
LASTF="$CDIR/backup-externo.last"
LOCAL_DIR="/var/backups/redlibre"
LOG="/var/log/redlibre-backup-externo.log"
CRONF="/etc/cron.d/redlibre-backup-externo"
SELF="/bin/backup-externo"
TG_API="https://api.telegram.org"

HOSTTAG="$(hostname -s 2>/dev/null | tr -c 'A-Za-z0-9\n' '_')"
[[ -z "$HOSTTAG" ]] && HOSTTAG="srv"

# --- valores por defecto -----------------------------------------------------
HORA=3
RET_DAILY=14
RET_WEEKLY=4
LOCAL_KEEP=3
CRON_ON=0
SSH_ON=0; SSH_HOST=""; SSH_PORT=22; SSH_USER="root"; SSH_DIR="redlibre-backups"
RC_ON=0;  RC_REMOTE=""
TG_ON=0;  TG_TOKEN=""; TG_CHAT=""

_line() { echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"; }
_pause() { echo -ne "\033[1;33m[ENTER]\033[0m "; read -r; }
_log() { echo "$(date '+%F %T') $*"; }
_ok() { echo -e "\033[1;32m$*\033[0m"; }
_warn() { echo -e "\033[1;33m$*\033[0m"; }
_err() { echo -e "\033[1;31m$*\033[0m"; }

_ask() { # _ask VAR "texto" "defecto"
	local _a
	echo -ne "\033[1;32m$2 [\033[1;37m$3\033[1;32m]: \033[1;37m"
	read -r _a
	echo -ne "\033[0m"
	_a="${_a#"${_a%%[![:space:]]*}"}"
	_a="${_a%"${_a##*[![:space:]]}"}"
	[[ -z "$_a" ]] && _a="$3"
	printf -v "$1" '%s' "$_a"
}

_yes() { # _yes "pregunta" [defecto s|n]
	local a d="${2:-n}" p="[s/N]"
	[[ "$d" = "s" ]] && p="[S/n]"
	echo -ne "\033[1;32m$1 $p: \033[1;37m"
	read -r a
	echo -ne "\033[0m"
	a="$(echo "${a:-$d}" | tr '[:upper:]' '[:lower:]')"
	[[ "$a" = "s" || "$a" = "si" || "$a" = "sí" || "$a" = "y" ]]
}

# --- configuración -----------------------------------------------------------
_load() {
	[[ -f "$CFG" ]] && . "$CFG"
}

_save() {
	mkdir -p "$CDIR"
	( umask 077
	{
		echo "# RedLibre backup-externo — generado automáticamente"
		for v in HORA RET_DAILY RET_WEEKLY LOCAL_KEEP CRON_ON SSH_ON SSH_HOST SSH_PORT SSH_USER SSH_DIR RC_ON RC_REMOTE TG_ON TG_TOKEN TG_CHAT; do
			printf '%s=%q\n' "$v" "${!v}"
		done
	} >"$CFG" )
	chmod 600 "$CFG"
}

_need_pkg() { # _need_pkg comando paquete
	command -v "$1" >/dev/null 2>&1 && return 0
	_warn "Instalando $2..."
	if command -v dnf >/dev/null 2>&1; then dnf install -y "$2" >/dev/null 2>&1
	elif command -v yum >/dev/null 2>&1; then yum install -y "$2" >/dev/null 2>&1
	elif command -v apt-get >/dev/null 2>&1; then apt-get install -y "$2" >/dev/null 2>&1
	fi
	command -v "$1" >/dev/null 2>&1
}

# --- cifrado -----------------------------------------------------------------
_ossl_new() { # entrada salida  (clave en $PASSF)
	if openssl enc -aes-256-cbc -pbkdf2 -pass pass:x </dev/null >/dev/null 2>&1; then
		openssl enc -aes-256-cbc -salt -pbkdf2 -iter 200000 -pass file:"$PASSF" -in "$1" -out "$2" 2>/dev/null
	else
		openssl enc -aes-256-cbc -salt -md sha256 -pass file:"$PASSF" -in "$1" -out "$2" 2>/dev/null
	fi
}

_ossl_dec() { # entrada salida passfile  → prueba pbkdf2 y luego modo antiguo
	local in="$1" out="$2" pf="$3"
	if openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass file:"$pf" -in "$in" -out "$out" 2>/dev/null \
		&& tar -tf "$out" >/dev/null 2>&1; then
		return 0
	fi
	if openssl enc -d -aes-256-cbc -md sha256 -pass file:"$pf" -in "$in" -out "$out" 2>/dev/null \
		&& tar -tf "$out" >/dev/null 2>&1; then
		return 0
	fi
	rm -f "$out"
	return 1
}

# --- construcción del respaldo -----------------------------------------------
_build() { # $1 = archivo .enc final
	local out="$1" st plain p
	local -a rel=()
	umask 077
	mkdir -p "$LOCAL_DIR"; chmod 700 "$LOCAL_DIR"
	st="$(mktemp -d /var/tmp/rlbk.XXXXXX)" || return 1
	rm -f /root/backup.vps
	if [[ -x /bin/userbackup ]]; then
		TERM=dumb /bin/userbackup botfile </dev/null >/dev/null 2>&1
	fi
	if [[ ! -s /root/backup.vps ]]; then
		_log "ERROR: userbackup no generó /root/backup.vps"
		rm -rf "$st"
		return 1
	fi
	mv -f /root/backup.vps "$st/backup.vps"

	for p in /etc/RedLibre/nodos /etc/RedLibre/*.conf /etc/RedLibre/*.env \
		/opt/hcr-server/fullchain.pem /opt/hcr-server/privkey.pem \
		/usr/local/etc/xray /etc/xray /etc/wireguard /etc/autostart \
		/etc/ssh/sshd_config /etc/default/dropbear /etc/squid/squid.conf /etc/squid3/squid.conf; do
		[[ -e "$p" ]] && rel+=("${p#/}")
	done
	if ((${#rel[@]})); then
		tar -C / -czf "$st/extras.tar.gz" "${rel[@]}" 2>/dev/null
	else
		tar -czf "$st/extras.tar.gz" -T /dev/null 2>/dev/null
	fi
	crontab -l >"$st/crontab.txt" 2>/dev/null || : >"$st/crontab.txt"
	{
		echo "RedLibre backup-externo"
		echo "fecha: $(date '+%F %T %z')"
		echo "host: $(hostname)"
		echo "ip: $(hostname -I 2>/dev/null | awk '{print $1}')"
		echo "so: $(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")"
		echo "usuarios_db: $(wc -l </root/usuarios.db 2>/dev/null || echo 0)"
		echo "--- extras ---"
		tar -tzf "$st/extras.tar.gz" 2>/dev/null | head -n 200
	} >"$st/MANIFEST.txt"

	plain="$st/pack.tar"
	tar -C "$st" -cf "$plain" backup.vps extras.tar.gz crontab.txt MANIFEST.txt 2>/dev/null || {
		_log "ERROR: no se pudo empaquetar"
		rm -rf "$st"; return 1
	}
	if ! _ossl_new "$plain" "$out.part"; then
		_log "ERROR: falló el cifrado (¿openssl o contraseña?)"
		rm -rf "$st"; rm -f "$out.part"
		return 1
	fi
	mv -f "$out.part" "$out"
	rm -rf "$st"
	return 0
}

# --- retención ---------------------------------------------------------------
# stdin: nombres de archivo; stdout: los que hay que borrar
_retention_list() {
	local f d wk i=0 wc=0
	local -A seen=()
	local keep_d="$RET_DAILY" keep_w="$RET_WEEKLY"
	[[ "$keep_d" =~ ^[0-9]+$ && "$keep_d" -ge 1 ]] || keep_d=14
	[[ "$keep_w" =~ ^[0-9]+$ ]] || keep_w=4
	while IFS= read -r f; do
		[[ -z "$f" ]] && continue
		i=$((i + 1))
		((i <= keep_d)) && continue
		d="$(sed -E 's/.*-([0-9]{8})-[0-9]{4}\.tar\.enc$/\1/' <<<"$f")"
		wk="$(date -d "${d:0:4}-${d:4:2}-${d:6:2}" +%G-%V 2>/dev/null)"
		if [[ -n "$wk" && -z "${seen[$wk]:-}" ]] && ((wc < keep_w)); then
			seen[$wk]=1
			wc=$((wc + 1))
			continue
		fi
		echo "$f"
	done < <(sort -r)
}

_mine() { grep -E "^rl-${HOSTTAG}-[0-9]{8}-[0-9]{4}\.tar\.enc$"; }

# --- destino SSH -------------------------------------------------------------
_ssh_cmd() {
	ssh -i "$SSHKEY" -p "$SSH_PORT" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
		-o ConnectTimeout=20 -o ServerAliveInterval=15 "$SSH_USER@$SSH_HOST" "$@"
}
_ssh_q() { _ssh_cmd "$@" </dev/null; }

_ssh_upload() {
	local f="$1" b sz rsz
	b="$(basename "$f")"
	_ssh_q "mkdir -p $SSH_DIR" || return 1
	_ssh_cmd "cat > $SSH_DIR/.$b.part && mv -f $SSH_DIR/.$b.part $SSH_DIR/$b" <"$f" || return 1
	sz="$(stat -c %s "$f")"
	rsz="$(_ssh_q "stat -c %s $SSH_DIR/$b" 2>/dev/null | tr -dc '0-9')"
	[[ "$sz" = "$rsz" ]]
}
_ssh_list() { _ssh_q "ls -1 $SSH_DIR 2>/dev/null"; }
_ssh_del() { _ssh_q "rm -f $SSH_DIR/$1"; }
_ssh_get() { _ssh_q "cat $SSH_DIR/$1" >"$2"; }

# --- destino rclone ----------------------------------------------------------
_rc_env() {
	[[ -z "${RCLONE_CONFIG:-}" && -f /root/.config/rclone/rclone.conf ]] && export RCLONE_CONFIG=/root/.config/rclone/rclone.conf
}
_rc_upload() {
	local f="$1" b sz rsz
	_rc_env
	b="$(basename "$f")"
	rclone copyto "$f" "$RC_REMOTE/$b" --retries 3 --low-level-retries 5 >>"$LOG" 2>&1 || return 1
	sz="$(stat -c %s "$f")"
	rsz="$(rclone lsf --format s "$RC_REMOTE/$b" 2>/dev/null | tr -dc '0-9')"
	[[ "$sz" = "$rsz" ]]
}
_rc_list() { _rc_env; rclone lsf "$RC_REMOTE" --files-only 2>/dev/null; }
_rc_del() { _rc_env; rclone deletefile "$RC_REMOTE/$1" >>"$LOG" 2>&1; }
_rc_get() { _rc_env; rclone copyto "$RC_REMOTE/$1" "$2" >>"$LOG" 2>&1; }

# --- destino Telegram --------------------------------------------------------
_tg_msg() {
	[[ -n "$TG_TOKEN" && -n "$TG_CHAT" ]] || return 1
	curl -s -m 30 -o /dev/null "$TG_API/bot$TG_TOKEN/sendMessage" \
		--data-urlencode "chat_id=$TG_CHAT" --data-urlencode "text=$1"
}
_tg_file() {
	local f="$1" sz
	sz="$(stat -c %s "$f")"
	if ((sz > 49000000)); then
		_tg_msg "⚠️ Respaldo de $HOSTTAG demasiado grande para Telegram ($((sz / 1048576)) MB)."
		return 1
	fi
	curl -s -m 180 "$TG_API/bot$TG_TOKEN/sendDocument" -F "chat_id=$TG_CHAT" \
		-F "document=@$f" -F "caption=♻️ Respaldo RedLibre $HOSTTAG $(date '+%F %H:%M') ($((sz / 1024)) KB, cifrado)" \
		| grep -q '"ok":true'
}
_tg_detect() {
	local l
	l="$(grep -ho 'bot [0-9]\{6,\}:[A-Za-z0-9_-]\{30,\} [0-9]\+' /etc/autostart 2>/dev/null | tail -n1)"
	[[ -z "$l" ]] && l="$(ps -eo args 2>/dev/null | grep -o 'bot [0-9]\{6,\}:[A-Za-z0-9_-]\{30,\} [0-9]\+' | head -n1)"
	[[ -z "$l" ]] && return 1
	_DET_TOKEN="$(awk '{print $2}' <<<"$l")"
	_DET_CHAT="$(awk '{print $3}' <<<"$l")"
	return 0
}

# --- ejecución del respaldo --------------------------------------------------
_run() {
	_load
	local lockf=/var/lock/redlibre-backup-externo.lock
	exec 9>"$lockf"
	if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
		_log "Ya hay un respaldo en curso."
		return 1
	fi
	if [[ -f "$LOG" && "$(stat -c %s "$LOG" 2>/dev/null)" -gt 1048576 ]]; then
		tail -n 500 "$LOG" >"$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
	fi
	if [[ ! -s "$PASSF" ]]; then
		_log "ERROR: no hay contraseña de cifrado configurada."
		_tg_msg "❌ Respaldo externo $HOSTTAG: falta la contraseña de cifrado."
		return 1
	fi
	_need_pkg openssl openssl >/dev/null 2>&1
	local name="rl-${HOSTTAG}-$(date +%Y%m%d-%H%M).tar.enc"
	local out="$LOCAL_DIR/$name" errs=0 dests="" sz
	_log "Inicio del respaldo → $name"
	if ! _build "$out"; then
		_log "FALLÓ la creación del respaldo."
		_tg_msg "❌ Respaldo externo $HOSTTAG: no se pudo crear el archivo."
		echo "$(date +%s)|FAIL|0||$name" >"$LASTF"
		return 1
	fi
	sz="$(stat -c %s "$out")"
	_log "Respaldo creado: $((sz / 1024)) KB (cifrado)"

	if [[ "$SSH_ON" = 1 ]]; then
		if _ssh_upload "$out"; then
			_log "SSH ($SSH_USER@$SSH_HOST): subido y verificado"
			dests+="ssh "
			_ssh_list | _mine | _retention_list | while read -r f; do
				_ssh_del "$f" && _log "SSH: borrado antiguo $f"
			done
		else
			_log "SSH: ERROR al subir"; errs=$((errs + 1))
		fi
	fi
	if [[ "$RC_ON" = 1 ]]; then
		if _rc_upload "$out"; then
			_log "rclone ($RC_REMOTE): subido y verificado"
			dests+="nube "
			_rc_list | _mine | _retention_list | while read -r f; do
				_rc_del "$f" && _log "rclone: borrado antiguo $f"
			done
		else
			_log "rclone: ERROR al subir"; errs=$((errs + 1))
		fi
	fi
	if [[ "$TG_ON" = 1 ]]; then
		if _tg_file "$out"; then
			_log "Telegram: enviado"; dests+="telegram "
		else
			_log "Telegram: ERROR al enviar"; errs=$((errs + 1))
		fi
	fi
	if [[ -z "$dests" && $errs -eq 0 ]]; then
		_log "AVISO: no hay destinos externos activos; solo copia local."
	fi

	# copias locales: se conservan las últimas LOCAL_KEEP
	ls -1 "$LOCAL_DIR"/rl-"${HOSTTAG}"-*.tar.enc 2>/dev/null | sort -r | tail -n +$((LOCAL_KEEP + 1)) | xargs -r rm -f

	if ((errs > 0)); then
		echo "$(date +%s)|PARCIAL|$sz|$dests|$name" >"$LASTF"
		_tg_msg "⚠️ Respaldo externo $HOSTTAG: $errs destino(s) fallaron. Revise /var/log/redlibre-backup-externo.log"
		return 1
	fi
	echo "$(date +%s)|OK|$sz|$dests|$name" >"$LASTF"
	_log "Respaldo completado."
	return 0
}

# --- cron --------------------------------------------------------------------
_cron_apply() {
	_load
	if [[ "$CRON_ON" = 1 ]]; then
		cat >"$CRONF" <<EOF
# RedLibre — respaldo externo diario
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 $HORA * * * root $SELF --run >>$LOG 2>&1
EOF
		chmod 644 "$CRONF"
		if command -v systemctl >/dev/null 2>&1; then
			systemctl enable --now crond >/dev/null 2>&1 || systemctl enable --now cron >/dev/null 2>&1
		fi
	else
		rm -f "$CRONF"
	fi
}

# --- estado ------------------------------------------------------------------
_show_status() {
	_load
	local ep st sz ds nm hrs col
	echo -e "\033[1;33mCifrado:\033[0m   $([[ -s $PASSF ]] && echo -e '\033[1;32mcontraseña configurada' || echo -e '\033[1;31mSIN contraseña')\033[0m"
	echo -e "\033[1;33mDiario:\033[0m    $([[ "$CRON_ON" = 1 && -f $CRONF ]] && echo -e "\033[1;32mACTIVO · $(printf '%02d' "$HORA"):15 (hora del servidor)" || echo -e '\033[1;31mdesactivado')\033[0m"
	echo -e "\033[1;33mDestinos:\033[0m"
	echo -e "   VPS SSH   : $([[ "$SSH_ON" = 1 ]] && echo -e "\033[1;32m$SSH_USER@$SSH_HOST:$SSH_PORT/$SSH_DIR" || echo -e '\033[1;31mno')\033[0m"
	echo -e "   Nube      : $([[ "$RC_ON" = 1 ]] && echo -e "\033[1;32m$RC_REMOTE" || echo -e '\033[1;31mno')\033[0m"
	echo -e "   Telegram  : $([[ "$TG_ON" = 1 ]] && echo -e "\033[1;32mchat $TG_CHAT" || echo -e '\033[1;31mno')\033[0m"
	echo -e "\033[1;33mRetención:\033[0m  $RET_DAILY diarios + $RET_WEEKLY semanales (locales: $LOCAL_KEEP)"
	if [[ -f "$LASTF" ]]; then
		IFS='|' read -r ep st sz ds nm <"$LASTF"
		hrs=$((($(date +%s) - ep) / 3600))
		col="\033[1;32m"
		[[ "$st" != "OK" || $hrs -gt 26 ]] && col="\033[1;31m"
		echo -e "\033[1;33mÚltimo:\033[0m     ${col}$st · hace ${hrs} h · $((sz / 1024)) KB · ${ds:-solo local}\033[0m"
		echo -e "             $nm"
		[[ $hrs -gt 26 && "$CRON_ON" = 1 ]] && _err "   ¡Hace más de 26 h sin respaldo! Revise la opción 10 (registro)."
	else
		echo -e "\033[1;33mÚltimo:\033[0m     \033[1;31msin respaldos todavía\033[0m"
	fi
}

# --- configuración de contraseña ---------------------------------------------
_cfg_pass() {
	local p1 p2
	clear; _line
	echo -e "\E[44;1;37m        Contraseña de cifrado del respaldo        \E[0m"; _line
	_warn "Los respaldos contienen hashes de contraseñas y claves privadas (WireGuard, TLS)."
	_warn "Por eso se cifran con AES-256 antes de salir del servidor."
	_err  "Guarde esta contraseña en OTRO lugar (gestor de contraseñas). Sin ella NO se puede restaurar."
	[[ -s "$PASSF" ]] && _warn "Ya existe una. Si la cambia, los respaldos viejos seguirán necesitando la anterior."
	echo ""
	echo -ne "\033[1;32mNueva contraseña (mín. 10 caracteres, vacío = cancelar): \033[1;37m"
	read -rs p1; echo
	[[ -z "$p1" ]] && { _warn "Cancelado."; _pause; return; }
	if ((${#p1} < 10)); then _err "Muy corta (mínimo 10)."; _pause; return; fi
	echo -ne "\033[1;32mRepita la contraseña: \033[1;37m"
	read -rs p2; echo
	if [[ "$p1" != "$p2" ]]; then _err "No coinciden."; _pause; return; fi
	( umask 077; printf '%s\n' "$p1" >"$PASSF" )
	chmod 600 "$PASSF"
	_ok "Contraseña guardada (archivo $PASSF, solo root)."
	_pause
}

# --- destino SSH: configuración ----------------------------------------------
_cfg_ssh() {
	_load
	clear; _line
	echo -e "\E[44;1;37m        Destino: otro VPS por SSH        \E[0m"; _line
	_warn "Use un servidor DISTINTO (idealmente otro proveedor). Se crea una clave SSH exclusiva."
	echo ""
	_ask SSH_HOST "IP o dominio del VPS de respaldo" "${SSH_HOST:-}"
	_ask SSH_PORT "Puerto SSH" "${SSH_PORT:-22}"
	_ask SSH_USER "Usuario remoto" "${SSH_USER:-root}"
	_ask SSH_DIR "Carpeta remota (relativa al home)" "${SSH_DIR:-redlibre-backups}"
	if [[ ! "$SSH_HOST" =~ ^[A-Za-z0-9._:-]+$ || ! "$SSH_PORT" =~ ^[0-9]+$ || ! "$SSH_USER" =~ ^[a-z_][a-z0-9_-]*$ \
		|| ! "$SSH_DIR" =~ ^[A-Za-z0-9._/-]+$ || "$SSH_DIR" == *..* ]]; then
		_err "Algún dato tiene caracteres no permitidos."; _pause; return
	fi
	_need_pkg ssh openssh-clients >/dev/null 2>&1 || _need_pkg ssh openssh-client >/dev/null 2>&1
	if [[ ! -f "$SSHKEY" ]]; then
		ssh-keygen -q -t ed25519 -N "" -f "$SSHKEY" -C "redlibre-backup-$HOSTTAG" >/dev/null 2>&1
		chmod 600 "$SSHKEY"
		_ok "Clave SSH creada."
	fi
	echo ""
	echo -e "\033[1;33mClave pública de este servidor:\033[0m"
	cat "$SSHKEY.pub"
	echo ""
	if _yes "¿Instalar la clave en el VPS remoto ahora (pedirá la contraseña del remoto una vez)?" s; then
		cat "$SSHKEY.pub" | ssh -p "$SSH_PORT" -o StrictHostKeyChecking=accept-new "$SSH_USER@$SSH_HOST" \
			'umask 077; mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys'
	else
		_warn "Agregue esa línea a ~/.ssh/authorized_keys del usuario remoto y vuelva a probar."
	fi
	echo ""
	if _ssh_q "mkdir -p $SSH_DIR && echo ok" 2>/dev/null | grep -q ok; then
		_ok "Conexión SSH sin contraseña: OK. Destino activado."
		SSH_ON=1
	else
		_err "No se pudo conectar sin contraseña. Destino NO activado."
		SSH_ON=0
	fi
	_save
	_pause
}

# --- destino rclone: configuración -------------------------------------------
_cfg_rclone() {
	_load
	clear; _line
	echo -e "\E[44;1;37m        Destino: nube con rclone        \E[0m"; _line
	_warn "Sirve para Cloudflare R2, Backblaze B2, Wasabi, Google Drive, etc."
	echo ""
	if ! command -v rclone >/dev/null 2>&1; then
		_warn "rclone no está instalado."
		if _yes "¿Instalarlo ahora?" s; then
			if command -v dnf >/dev/null 2>&1 && dnf install -y rclone >/dev/null 2>&1; then :
			elif command -v apt-get >/dev/null 2>&1 && apt-get install -y rclone >/dev/null 2>&1; then :
			else
				_warn "Se usará el instalador oficial (https://rclone.org/install.sh)."
				_need_pkg curl curl >/dev/null 2>&1
				curl -fsSL https://rclone.org/install.sh | bash >/dev/null 2>&1
			fi
		fi
		command -v rclone >/dev/null 2>&1 || { _err "No se pudo instalar rclone."; _pause; return; }
	fi
	_rc_env
	echo -e "\033[1;33mRemotos ya configurados:\033[0m"
	rclone listremotes 2>/dev/null || true
	echo ""
	if _yes "¿Crear/editar un remoto ahora con 'rclone config'?" n; then
		rclone config
	fi
	echo ""
	_warn "Formato: nombre_del_remoto:bucket/carpeta   (ej.: r2:mis-respaldos/redlibre)"
	_ask RC_REMOTE "Remoto y carpeta" "${RC_REMOTE:-}"
	if [[ ! "$RC_REMOTE" =~ ^[A-Za-z0-9_.-]+:[A-Za-z0-9_./-]+$ ]]; then
		_err "Formato inválido."; RC_ON=0; _save; _pause; return
	fi
	echo -e "\033[1;33mProbando...\033[0m"
	if rclone mkdir "$RC_REMOTE" >/dev/null 2>&1 && rclone lsf "$RC_REMOTE" --max-depth 1 >/dev/null 2>&1; then
		_ok "Acceso a la nube: OK. Destino activado."
		RC_ON=1
	else
		_err "No se pudo acceder a $RC_REMOTE. Revise 'rclone config'. Destino NO activado."
		RC_ON=0
	fi
	_save
	_pause
}

# --- destino Telegram: configuración -----------------------------------------
_cfg_tg() {
	_load
	clear; _line
	echo -e "\E[44;1;37m        Destino: Telegram (archivo cifrado)        \E[0m"; _line
	_warn "Límite de Telegram: 50 MB por archivo. También se usa para avisarle si un respaldo falla."
	echo ""
	if _tg_detect; then
		_ok "Bot detectado en este servidor (menú 25): chat $_DET_CHAT"
		if _yes "¿Usar ese bot y ese chat?" s; then
			TG_TOKEN="$_DET_TOKEN"; TG_CHAT="$_DET_CHAT"
		fi
	fi
	if [[ -z "$TG_TOKEN" ]]; then
		_ask TG_TOKEN "Token del bot" ""
		_ask TG_CHAT "ID del chat" ""
	fi
	if [[ ! "$TG_TOKEN" =~ ^[0-9]+:[A-Za-z0-9_-]+$ || ! "$TG_CHAT" =~ ^-?[0-9]+$ ]]; then
		_err "Token o chat inválido."; TG_ON=0; _save; _pause; return
	fi
	_need_pkg curl curl >/dev/null 2>&1
	if curl -s -m 30 "$TG_API/bot$TG_TOKEN/sendMessage" --data-urlencode "chat_id=$TG_CHAT" \
		--data-urlencode "text=✅ Prueba de respaldo externo RedLibre ($HOSTTAG)" | grep -q '"ok":true'; then
		_ok "Mensaje de prueba enviado. Destino activado."
		TG_ON=1
	else
		_err "No se pudo enviar. Revise token/chat (envíe /start al bot primero)."
		TG_ON=0
	fi
	_save
	_pause
}

# --- programación ------------------------------------------------------------
_cfg_sched() {
	_load
	clear; _line
	echo -e "\E[44;1;37m        Programación y retención        \E[0m"; _line
	if [[ ! -s "$PASSF" ]]; then _err "Primero configure la contraseña (opción 2)."; _pause; return; fi
	if [[ "$CRON_ON" = 1 ]]; then
		_ok "El respaldo diario está ACTIVO."
		if _yes "¿Desactivarlo?" n; then CRON_ON=0; _save; _cron_apply; _warn "Desactivado."; _pause; return; fi
	else
		_warn "El respaldo diario está desactivado."
	fi
	_ask HORA "Hora del día (0-23, hora del servidor)" "$HORA"
	[[ "$HORA" =~ ^[0-9]+$ && "$HORA" -le 23 ]] || { _err "Hora inválida."; _pause; return; }
	HORA=$((10#$HORA))
	_ask RET_DAILY "Cuántos respaldos DIARIOS conservar" "$RET_DAILY"
	_ask RET_WEEKLY "Cuántos SEMANALES conservar (uno por semana)" "$RET_WEEKLY"
	_ask LOCAL_KEEP "Copias locales en este servidor" "$LOCAL_KEEP"
	[[ "$RET_DAILY" =~ ^[0-9]+$ && "$RET_DAILY" -ge 1 && "$RET_WEEKLY" =~ ^[0-9]+$ && "$LOCAL_KEEP" =~ ^[0-9]+$ && "$LOCAL_KEEP" -ge 1 ]] \
		|| { _err "Valores inválidos."; _pause; return; }
	if [[ "$SSH_ON" != 1 && "$RC_ON" != 1 && "$TG_ON" != 1 ]]; then
		_warn "No hay destinos externos activos: solo se guardaría copia local (no protege si el servidor cae)."
		_yes "¿Activar igualmente?" n || { _pause; return; }
	fi
	CRON_ON=1
	_save
	_cron_apply
	_ok "Respaldo diario activado a las ${HORA}:15 (hora del servidor)."
	_pause
}

# --- probar destinos / ejecutar ----------------------------------------------
_test_dests() {
	_load
	clear; _line
	echo -e "\E[44;1;37m        Probar destinos        \E[0m"; _line
	local any=0
	if [[ "$SSH_ON" = 1 ]]; then
		any=1
		_ssh_q "mkdir -p $SSH_DIR && echo ok" 2>/dev/null | grep -q ok && _ok "SSH: OK" || _err "SSH: FALLA"
	fi
	if [[ "$RC_ON" = 1 ]]; then
		any=1
		_rc_env
		rclone lsf "$RC_REMOTE" --max-depth 1 >/dev/null 2>&1 && _ok "Nube: OK" || _err "Nube: FALLA"
	fi
	if [[ "$TG_ON" = 1 ]]; then
		any=1
		_tg_msg "✅ Prueba RedLibre $HOSTTAG" && _ok "Telegram: mensaje enviado" || _err "Telegram: FALLA"
	fi
