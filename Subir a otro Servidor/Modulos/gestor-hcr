#!/bin/bash
#====================================================
# Submenú — Gestor HCR Server (relay HCR → SSH local)
# Bundle: Subir a otro Servidor/HCR/  →  /opt/hcr-server
# Menú principal opción 32
#====================================================
[[ $EUID -eq 0 ]] || {
    echo -e "\033[1;31mEjecute como root.\033[0m"
    exit 1
}

CONF_DIR="/etc/RedLibre"
CONF_FILE="$CONF_DIR/hcr.conf"
INSTALL_DIR="/opt/hcr-server"
SERVICE_NAME="hcr-server"
URL_BASE="https://github.com/josecarlosmeza/linux/raw/main/Subir%20a%20otro%20Servidor/HCR"

# Defaults (datos de publicacion)
PORT_DEFAULT="8880"
TRANSPORT_DEFAULT="plain"
FRAME_DEFAULT="6144"
POLL_DEFAULT="8s"
TARGET_SSH_IP_DEFAULT="127.0.0.1"
TARGET_SSH_PORT_DEFAULT="22"

_hcr_load_conf() {
    PORT="$PORT_DEFAULT"
    TRANSPORT="$TRANSPORT_DEFAULT"
    MAX_DOWNLOAD_FRAME="$FRAME_DEFAULT"
    DOWNLOAD_POLL_TIMEOUT="$POLL_DEFAULT"
    TARGET_SSH_IP="$TARGET_SSH_IP_DEFAULT"
    TARGET_SSH_PORT="$TARGET_SSH_PORT_DEFAULT"
    DIAG_INTERVAL="0"
    MAX_SESSIONS_PER_IP="0"
    MAX_SESSIONS="0"
    MAX_CONNECTIONS="0"
    if [[ -f "$CONF_FILE" ]]; then
        # shellcheck disable=SC1090
        . "$CONF_FILE"
    fi
    PORT="${PORT:-$PORT_DEFAULT}"
    TRANSPORT="${TRANSPORT:-$TRANSPORT_DEFAULT}"
    MAX_DOWNLOAD_FRAME="${MAX_DOWNLOAD_FRAME:-$FRAME_DEFAULT}"
    DOWNLOAD_POLL_TIMEOUT="${DOWNLOAD_POLL_TIMEOUT:-$POLL_DEFAULT}"
    TARGET_SSH_IP="${TARGET_SSH_IP:-$TARGET_SSH_IP_DEFAULT}"
    TARGET_SSH_PORT="${TARGET_SSH_PORT:-$TARGET_SSH_PORT_DEFAULT}"
    DIAG_INTERVAL="${DIAG_INTERVAL:-0}"
    MAX_SESSIONS_PER_IP="${MAX_SESSIONS_PER_IP:-0}"
    MAX_SESSIONS="${MAX_SESSIONS:-0}"
    MAX_CONNECTIONS="${MAX_CONNECTIONS:-0}"
}

_hcr_save_conf() {
    mkdir -p "$CONF_DIR"
    cat >"$CONF_FILE" <<EOF
# RedLibre HCR — generado por gestor-hcr
PORT=$PORT
TRANSPORT=$TRANSPORT
MAX_DOWNLOAD_FRAME=$MAX_DOWNLOAD_FRAME
DOWNLOAD_POLL_TIMEOUT=$DOWNLOAD_POLL_TIMEOUT
TARGET_SSH_IP=$TARGET_SSH_IP
TARGET_SSH_PORT=$TARGET_SSH_PORT
DIAG_INTERVAL=$DIAG_INTERVAL
MAX_SESSIONS_PER_IP=$MAX_SESSIONS_PER_IP
MAX_SESSIONS=$MAX_SESSIONS
MAX_CONNECTIONS=$MAX_CONNECTIONS
INSTALL_DIR=$INSTALL_DIR
EOF
    chmod 644 "$CONF_FILE"
}

_hcr_active() {
    command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "${SERVICE_NAME}.service" 2>/dev/null
}

_hcr_status_text() {
    if _hcr_active; then
        _hcr_load_conf
        printf '%s' "ACTIVO · :${PORT} · ${TRANSPORT} · SSH ${TARGET_SSH_IP}:${TARGET_SSH_PORT}"
    elif [[ -x "$INSTALL_DIR/hcr-server" ]] || [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then
        printf '%s' "INSTALADO / INACTIVO"
    else
        printf '%s' "NO INSTALADO"
    fi
}

_hcr_pause() {
    echo -ne "\033[1;33m[ENTER]\033[0m "
    read -r
}

_hcr_ask_port() {
    local def ans
    def="${1:-$PORT_DEFAULT}"
    echo -e "\033[1;33mPuerto de escucha HCR (clientes se conectan aquí).\033[0m"
    echo -ne "\033[1;32mPuerto HCR [\033[1;37m$def\033[1;32m]: \033[1;37m"
    read -r ans
    ans="${ans//[[:space:]]/}"
    [[ -z "$ans" ]] && ans="$def"
    if ! [[ "$ans" =~ ^[1-9][0-9]*$ ]] || [[ "$ans" -gt 65535 ]]; then
        echo -e "\033[1;31mPuerto inválido; se usa $def.\033[0m"
        ans="$def"
    fi
    _ASK_PORT="$ans"
}

_hcr_ask_ssh_target() {
    local dip dport ans
    dip="${1:-$TARGET_SSH_IP_DEFAULT}"
    dport="${2:-$TARGET_SSH_PORT_DEFAULT}"
    echo -e "\033[1;33mDestino SSH (a dónde reenvía el HCR).\033[0m"
    echo -ne "\033[1;32mIP SSH [\033[1;37m$dip\033[1;32m]: \033[1;37m"
    read -r ans
    ans="${ans//[[:space:]]/}"
    [[ -z "$ans" ]] && ans="$dip"
    _ASK_SSH_IP="$ans"
    echo -ne "\033[1;32mPuerto SSH [\033[1;37m$dport\033[1;32m]: \033[1;37m"
    read -r ans
    ans="${ans//[[:space:]]/}"
    [[ -z "$ans" ]] && ans="$dport"
    if ! [[ "$ans" =~ ^[1-9][0-9]*$ ]] || [[ "$ans" -gt 65535 ]]; then
        echo -e "\033[1;31mPuerto SSH inválido; se usa $dport.\033[0m"
        ans="$dport"
    fi
    _ASK_SSH_PORT="$ans"
}

_hcr_run_install() {
    local tgt="${TARGET_SSH_IP}:${TARGET_SSH_PORT}"
    local -a args=(--port "$PORT" --transport "$TRANSPORT" --target "$tgt"
        --max-download-frame "$MAX_DOWNLOAD_FRAME"
        --download-poll-timeout "$DOWNLOAD_POLL_TIMEOUT")
    # Opciones nuevas (solo se pasan si estan activas; el instalador
    # vuelve a los valores por defecto cuando no se mencionan).
    [[ "${DIAG_INTERVAL:-0}" != "0" ]] && args+=(--diagnostics-interval "$DIAG_INTERVAL")
    [[ "${MAX_SESSIONS_PER_IP:-0}" != "0" ]] && args+=(--max-sessions-per-ip "$MAX_SESSIONS_PER_IP")
    [[ "${MAX_SESSIONS:-0}" != "0" ]] && args+=(--max-sessions "$MAX_SESSIONS")
    [[ "${MAX_CONNECTIONS:-0}" != "0" ]] && args+=(--max-connections "$MAX_CONNECTIONS")
    (cd "$INSTALL_DIR" && bash ./install.sh "${args[@]}")
}

_hcr_ask_transport() {
    local def ans
    def="${1:-$TRANSPORT_DEFAULT}"
    echo -e "\033[1;33mTransporte:\033[0m"
    echo -e "\033[1;37m  1) plain  — solo HCR sin TLS (recomendado según publicación)\033[0m"
    echo -e "\033[1;37m  2) tls    — solo TLS (requiere fullchain.pem + privkey.pem)\033[0m"
    echo -e "\033[1;37m  3) auto   — TLS + plain en el mismo puerto\033[0m"
    echo -ne "\033[1;32mOpción [1=plain / 2=tls / 3=auto] (default \033[1;37m$def\033[1;32m): \033[1;37m"
    read -r ans
    ans="${ans//[[:space:]]/}"
    case "$ans" in
        1|plain) _ASK_TRANSPORT="plain" ;;
        2|tls) _ASK_TRANSPORT="tls" ;;
        3|auto) _ASK_TRANSPORT="auto" ;;
        "") _ASK_TRANSPORT="$def" ;;
        *)
            echo -e "\033[1;31mValor inválido; se usa $def.\033[0m"
            _ASK_TRANSPORT="$def"
            ;;
    esac
}

_hcr_ask_perf() {
    local def_f def_p ans
    def_f="${1:-$FRAME_DEFAULT}"
    def_p="${2:-$POLL_DEFAULT}"
    echo -e "\033[1;33mFrame de descarga: rango 1-262140 bytes. Por encima de 16384 todos los"
    echo -e "clientes HC deben estar actualizados. Mas grande no siempre es mas rapido.\033[0m"
    echo -ne "\033[1;32mMAX_DOWNLOAD_FRAME [\033[1;37m$def_f\033[1;32m]: \033[1;37m"
    read -r ans
    ans="${ans//[[:space:]]/}"
    [[ -z "$ans" ]] && ans="$def_f"
    if ! [[ "$ans" =~ ^[1-9][0-9]*$ ]] || [[ "${#ans}" -gt 6 ]] || [[ "$ans" -gt 262140 ]]; then
        echo -e "\033[1;31mFrame invalido (1-262140); se usa $def_f.\033[0m"
        ans="$def_f"
    fi
    if [[ "$ans" -gt 16384 ]]; then
        echo -e "\033[1;33mAviso: >16384 exige HC actualizado en todos los clientes de este puerto.\033[0m"
    fi
    _ASK_FRAME="$ans"
    echo -ne "\033[1;32mDOWNLOAD_POLL_TIMEOUT (ej. 8s) [\033[1;37m$def_p\033[1;32m]: \033[1;37m"
    read -r ans
    ans="${ans//[[:space:]]/}"
    [[ -z "$ans" ]] && ans="$def_p"
    if ! [[ "$ans" =~ ^[0-9]+(ms|s|m)$ ]]; then
        echo -e "\033[1;31mFormato invalido (ej. 8s, 500ms); se usa $def_p.\033[0m"
        ans="$def_p"
    fi
    _ASK_POLL="$ans"
}

_hcr_ensure_tls() {
    local cert="$INSTALL_DIR/fullchain.pem" key="$INSTALL_DIR/privkey.pem"
    if [[ -f "$cert" && -f "$key" ]]; then
        return 0
    fi
    echo -e "\033[1;33mFaltan certificados TLS en $INSTALL_DIR\033[0m"
    echo -ne "\033[1;32m¿Generar certificado autofirmado? [s/N]: \033[1;37m"
    read -r ans
    ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
    if [[ "$ans" != "s" && "$ans" != "si" && "$ans" != "y" ]]; then
        echo -e "\033[1;31mColoque fullchain.pem y privkey.pem en $INSTALL_DIR e intente de nuevo.\033[0m"
        return 1
    fi
    command -v openssl >/dev/null 2>&1 || {
        echo -e "\033[1;31mopenssl no está instalado.\033[0m"
        return 1
    }
    openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "$key" -out "$cert" -days 3650 \
        -subj "/CN=hcr-server" >/dev/null 2>&1 || return 1
    chown root:root "$cert" "$key"
    chmod 644 "$cert"
    chmod 600 "$key"
    echo -e "\033[1;32mCertificado autofirmado creado.\033[0m"
}

_hcr_download_bundle() {
    mkdir -p "$INSTALL_DIR"
    chown root:root "$INSTALL_DIR"
    chmod 755 "$INSTALL_DIR"
    echo -e "\033[1;32mDescargando hcr-server e install.sh…\033[0m"
    # Se descarga a temporales y solo se reemplaza si ambos llegaron completos.
    local tb="$INSTALL_DIR/.hcr-server.new" ti="$INSTALL_DIR/.install.sh.new"
    rm -f "$tb" "$ti"
    if ! wget -qO "$tb" "${URL_BASE}/hcr-server" || [[ ! -s "$tb" ]]; then
        echo -e "\033[1;31mNo se pudo descargar el binario hcr-server.\033[0m"
        rm -f "$tb" "$ti"
        return 1
    fi
    if ! wget -qO "$ti" "${URL_BASE}/install.sh" || [[ ! -s "$ti" ]]; then
        echo -e "\033[1;31mNo se pudo descargar install.sh.\033[0m"
        rm -f "$tb" "$ti"
        return 1
    fi
    [[ -f "$INSTALL_DIR/hcr-server" ]] && cp -f "$INSTALL_DIR/hcr-server" "$INSTALL_DIR/hcr-server.bak" 2>/dev/null
    mv -f "$tb" "$INSTALL_DIR/hcr-server"
    mv -f "$ti" "$INSTALL_DIR/install.sh"
    sed -i 's/\r$//' "$INSTALL_DIR/install.sh" 2>/dev/null || true
    chown root:root "$INSTALL_DIR/hcr-server" "$INSTALL_DIR/install.sh"
    chmod 755 "$INSTALL_DIR/hcr-server" "$INSTALL_DIR/install.sh"
    # Cadena de directorios: install.sh exige owned by root y no world-writable
    local d="$INSTALL_DIR"
    while [[ -n "$d" && "$d" != "/" ]]; do
        chown root:root "$d" 2>/dev/null || true
        chmod go-w "$d" 2>/dev/null || true
        d="$(dirname "$d")"
    done
}

_hcr_do_install() {
    _hcr_load_conf
    clear
    echo -e "\033[1;32mInstalar / reactivar HCR Server\033[0m"
    echo ""
    _hcr_ask_port "$PORT"
    PORT="$_ASK_PORT"
    echo ""
    _hcr_ask_ssh_target "$TARGET_SSH_IP" "$TARGET_SSH_PORT"
    TARGET_SSH_IP="$_ASK_SSH_IP"
    TARGET_SSH_PORT="$_ASK_SSH_PORT"
    echo ""
    _hcr_ask_transport "$TRANSPORT"
    TRANSPORT="$_ASK_TRANSPORT"
    echo ""
    _hcr_ask_perf "$MAX_DOWNLOAD_FRAME" "$DOWNLOAD_POLL_TIMEOUT"
    MAX_DOWNLOAD_FRAME="$_ASK_FRAME"
    DOWNLOAD_POLL_TIMEOUT="$_ASK_POLL"
    _hcr_save_conf

    if [[ ! -x "$INSTALL_DIR/hcr-server" || ! -f "$INSTALL_DIR/install.sh" ]]; then
        _hcr_download_bundle || {
            _hcr_pause
            return 1
        }
    else
        echo -e "\033[1;37mUsando bundle existente en $INSTALL_DIR\033[0m"
        echo -ne "\033[1;32m¿Re-descargar desde GitHub? [s/N]: \033[1;37m"
        read -r ans
        ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
        if [[ "$ans" == "s" || "$ans" == "si" || "$ans" == "y" ]]; then
            _hcr_download_bundle || {
                _hcr_pause
                return 1
            }
        fi
    fi

    if [[ "$TRANSPORT" == "tls" || "$TRANSPORT" == "auto" ]]; then
        _hcr_ensure_tls || {
            _hcr_pause
            return 1
        }
    fi

    echo ""
    echo -e "\033[1;32mEjecutando install.sh --port $PORT --transport $TRANSPORT --target ${TARGET_SSH_IP}:${TARGET_SSH_PORT}\033[0m"
    if ! _hcr_run_install; then
        echo -e "\033[1;31mLa instalación falló. Revise el mensaje anterior.\033[0m"
        _hcr_pause
        return 1
    fi
    echo -e "\033[1;32mListo. Estado: $(_hcr_status_text)\033[0m"
    _hcr_pause
}

_hcr_do_reconfig() {
    _hcr_load_conf
    if [[ ! -f "$INSTALL_DIR/install.sh" ]]; then
        echo -e "\033[1;31mHCR no está instalado. Use la opción 1.\033[0m"
        _hcr_pause
        return 1
    fi
    clear
    echo -e "\033[1;32mCambiar puerto HCR / transporte / destino SSH\033[0m"
    echo ""
    _hcr_ask_port "$PORT"
    PORT="$_ASK_PORT"
    echo ""
    _hcr_ask_ssh_target "$TARGET_SSH_IP" "$TARGET_SSH_PORT"
    TARGET_SSH_IP="$_ASK_SSH_IP"
    TARGET_SSH_PORT="$_ASK_SSH_PORT"
    echo ""
    _hcr_ask_transport "$TRANSPORT"
    TRANSPORT="$_ASK_TRANSPORT"
    _hcr_save_conf
    if [[ "$TRANSPORT" == "tls" || "$TRANSPORT" == "auto" ]]; then
        _hcr_ensure_tls || {
            _hcr_pause
            return 1
        }
    fi
    _hcr_run_install || true
    echo -e "\033[1;32mEstado: $(_hcr_status_text)\033[0m"
    _hcr_pause
}

_hcr_do_ssh_only() {
    _hcr_load_conf
    if [[ ! -f "$INSTALL_DIR/install.sh" ]]; then
        echo -e "\033[1;31mHCR no está instalado. Use la opción 1.\033[0m"
        _hcr_pause
        return 1
    fi
    clear
    echo -e "\033[1;32mModificar destino SSH\033[0m"
    echo -e "\033[1;37mActual: ${TARGET_SSH_IP}:${TARGET_SSH_PORT}\033[0m"
    echo ""
    _hcr_ask_ssh_target "$TARGET_SSH_IP" "$TARGET_SSH_PORT"
    TARGET_SSH_IP="$_ASK_SSH_IP"
    TARGET_SSH_PORT="$_ASK_SSH_PORT"
    _hcr_save_conf
    _hcr_run_install || true
    echo -e "\033[1;32mSSH destino: ${TARGET_SSH_IP}:${TARGET_SSH_PORT}\033[0m"
    echo -e "\033[1;32mEstado: $(_hcr_status_text)\033[0m"
    _hcr_pause
}

_hcr_do_perf() {
    _hcr_load_conf
    if [[ ! -f "$INSTALL_DIR/install.sh" ]]; then
        echo -e "\033[1;31mHCR no está instalado. Use la opción 1.\033[0m"
        _hcr_pause
        return 1
    fi
    clear
    echo -e "\033[1;32mAjuste de rendimiento\033[0m"
    echo ""
    _hcr_ask_perf "$MAX_DOWNLOAD_FRAME" "$DOWNLOAD_POLL_TIMEOUT"
    MAX_DOWNLOAD_FRAME="$_ASK_FRAME"
    DOWNLOAD_POLL_TIMEOUT="$_ASK_POLL"
    _hcr_save_conf
    _hcr_run_install || true
    echo -e "\033[1;32mAplicado. Estado: $(_hcr_status_text)\033[0m"
    _hcr_pause
}

_hcr_version_text() {
    local v=""
    if [[ -x "$INSTALL_DIR/hcr-server" ]]; then
        v="$("$INSTALL_DIR/hcr-server" -version 2>&1 | head -n 1)"
    fi
    printf '%s' "${v:-desconocida}"
}

_hcr_do_update() {
    _hcr_load_conf
    clear
    echo -e "\033[1;32mActualizar HCR Server (binario + install.sh)\033[0m"
    echo -e "\033[1;37mVersion actual: $(_hcr_version_text)\033[0m"
    echo -e "\033[1;37mSe conserva tu configuracion: puerto, transporte, SSH, frame, poll y opciones avanzadas.\033[0m"
    echo -e "\033[1;33mEl servicio se reinicia y las sesiones activas se cortan unos segundos.\033[0m"
    echo -ne "\033[1;32m¿Continuar? [s/N]: \033[1;37m"
    read -r ans
    ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
    if [[ "$ans" != "s" && "$ans" != "si" && "$ans" != "y" ]]; then
        echo -e "\033[1;33mCancelado.\033[0m"
        _hcr_pause
        return 0
    fi
    _hcr_download_bundle || {
        echo -e "\033[1;31mActualizacion cancelada; no se toco la version instalada.\033[0m"
        _hcr_pause
        return 1
    }
    if [[ "$TRANSPORT" == "tls" || "$TRANSPORT" == "auto" ]]; then
        _hcr_ensure_tls || {
            _hcr_pause
            return 1
        }
    fi
    if ! _hcr_run_install; then
        echo -e "\033[1;31mFallo al aplicar la nueva version. Restaurando binario anterior...\033[0m"
        if [[ -f "$INSTALL_DIR/hcr-server.bak" ]]; then
            cp -f "$INSTALL_DIR/hcr-server.bak" "$INSTALL_DIR/.hcr-server.rb" &&
                chmod 755 "$INSTALL_DIR/.hcr-server.rb" &&
                mv -f "$INSTALL_DIR/.hcr-server.rb" "$INSTALL_DIR/hcr-server"
            systemctl restart "${SERVICE_NAME}.service" 2>/dev/null || true
        fi
        _hcr_pause
        return 1
    fi
    echo -e "\033[1;32mActualizado. Version: $(_hcr_version_text)\033[0m"
    echo -e "\033[1;32mEstado: $(_hcr_status_text)\033[0m"
    _hcr_pause
}

_hcr_do_advanced() {
    _hcr_load_conf
    if [[ ! -f "$INSTALL_DIR/install.sh" ]]; then
        echo -e "\033[1;31mHCR no está instalado. Use la opción 1.\033[0m"
        _hcr_pause
        return 1
    fi
    clear
    echo -e "\033[1;32mOpciones avanzadas (0 = desactivado / valor por defecto del servidor)\033[0m"
    echo ""
    local ans
    echo -ne "\033[1;32mDiagnostico de ruta (0, o 10s a 5m, ej. 10s) [\033[1;37m$DIAG_INTERVAL\033[1;32m]: \033[1;37m"
    read -r ans; ans="${ans//[[:space:]]/}"
    if [[ -n "$ans" ]]; then
        if [[ "$ans" == "0" || "$ans" =~ ^[0-9]+(s|m)$ ]]; then DIAG_INTERVAL="$ans"
        else echo -e "\033[1;31mValor invalido; se conserva $DIAG_INTERVAL.\033[0m"; fi
    fi
    local lbl var
    for lbl in "Limite de sesiones por IP:MAX_SESSIONS_PER_IP" "Limite total de sesiones:MAX_SESSIONS" "Limite de conexiones/solicitudes:MAX_CONNECTIONS"; do
        var="${lbl##*:}"
        echo -ne "\033[1;32m${lbl%%:*} (0 = defecto) [\033[1;37m${!var}\033[1;32m]: \033[1;37m"
        read -r ans; ans="${ans//[[:space:]]/}"
        if [[ -n "$ans" ]]; then
            if [[ "$ans" =~ ^[0-9]+$ ]]; then printf -v "$var" '%s' "$((10#$ans))"
            else echo -e "\033[1;31mValor invalido; se conserva ${!var}.\033[0m"; fi
        fi
    done
    _hcr_save_conf
    _hcr_run_install || true
    echo -e "\033[1;32mEstado: $(_hcr_status_text)\033[0m"
    [[ "$DIAG_INTERVAL" != "0" ]] && echo -e "\033[1;37mLogs de diagnostico: journalctl -u ${SERVICE_NAME} -f\033[0m"
    _hcr_pause
}

_hcr_do_restart() {
    if systemctl restart "${SERVICE_NAME}.service" 2>/dev/null; then
        echo -e "\033[1;32mServicio reiniciado.\033[0m"
    else
        echo -e "\033[1;31mNo se pudo reiniciar (¿instalado?).\033[0m"
    fi
    _hcr_pause
}

_hcr_do_stop() {
    systemctl stop "${SERVICE_NAME}.service" 2>/dev/null || true
    echo -e "\033[1;32mServicio detenido (no desinstalado).\033[0m"
    _hcr_pause
}

_hcr_do_status() {
    clear
    _hcr_load_conf
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\E[44;1;37m     Estado HCR Server      \E[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    echo -e "\033[1;33mEstado:\033[1;37m $(_hcr_status_text)\033[0m"
    echo -e "\033[1;33mVersion:\033[1;37m $(_hcr_version_text)\033[0m"
    echo -e "\033[1;33mConfig:\033[1;37m $CONF_FILE\033[0m"
    [[ -f "$CONF_FILE" ]] && cat "$CONF_FILE"
    echo ""
    echo -e "\033[1;33m# systemctl status\033[0m"
    systemctl status "${SERVICE_NAME}.service" --no-pager -l 2>/dev/null | head -n 20 || echo "(sin unidad)"
    echo ""
    echo -e "\033[1;33m# Puerto en escucha\033[0m"
    if command -v ss >/dev/null 2>&1; then
        ss -tlnp 2>/dev/null | grep -E ":${PORT}\\b" || echo "(nada en :$PORT)"
    else
        netstat -tlnp 2>/dev/null | grep -E ":${PORT}\\b" || echo "(nada en :$PORT)"
    fi
    echo ""
    echo -e "\033[1;33m# Últimos logs\033[0m"
    journalctl -u "${SERVICE_NAME}.service" -n 20 --no-pager 2>/dev/null || echo "(sin journal)"
    echo ""
    _hcr_pause
}

_hcr_do_uninstall() {
    clear
    echo -e "\033[1;31mDesinstalar servicio HCR (conserva archivos en $INSTALL_DIR)\033[0m"
    echo -ne "\033[1;32m¿Confirmar? [s/N]: \033[1;37m"
    read -r ans
    ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
    if [[ "$ans" != "s" && "$ans" != "si" && "$ans" != "y" ]]; then
        echo -e "\033[1;33mCancelado.\033[0m"
        _hcr_pause
        return 0
    fi
    if [[ -f "$INSTALL_DIR/install.sh" ]]; then
        (cd "$INSTALL_DIR" && bash ./install.sh --uninstall) || true
    else
        systemctl disable --now "${SERVICE_NAME}.service" 2>/dev/null || true
        rm -f "/etc/systemd/system/${SERVICE_NAME}.service"
        systemctl daemon-reload 2>/dev/null || true
    fi
    echo -e "\033[1;32mDesinstalado.\033[0m"
    _hcr_pause
}

