    echo -e "\033[1;31m[\033[1;36m6\033[1;31m]\033[1;33m Detener servicio\033[0m"
    echo -e "\033[1;31m[\033[1;36m7\033[1;31m]\033[1;33m Ver estado y logs\033[0m"
    echo -e "\033[1;31m[\033[1;36m8\033[1;31m]\033[1;33m Desinstalar servicio\033[0m"
    echo -e "\033[1;31m[\033[1;36m9\033[1;31m]\033[1;33m Actualizar HCR (binario + install.sh)\033[0m"
    echo -e "\033[1;31m[\033[1;36m10\033[1;31m]\033[1;33m Opciones avanzadas (diagnóstico / límites)\033[0m"
    echo -e "\033[1;31m[\033[1;36m0\033[1;31m]\033[1;33m Volver al menú\033[0m"
    echo ""
    echo -ne "\033[1;32mOpción: \033[1;37m"
    read -r _op
    case "${_op:-}" in
        1) _hcr_do_install ;;
        2) _hcr_do_reconfig ;;
        3) _hcr_do_ssh_only ;;
        4) _hcr_do_perf ;;
        5) clear; _hcr_do_restart ;;
        6) clear; _hcr_do_stop ;;
        7) _hcr_do_status ;;
        8) _hcr_do_uninstall ;;
        9) _hcr_do_update ;;
