#!/bin/bash
#====================================================
# Backup / restauración administrador
# Incluye usuarios SSH y configuración completa de revendedores
#====================================================

# Usuarios de prueba (script en userteste/) no se respaldan: son temporales.
_redlibre_list_pruebas() {
	local f u
	shopt -s nullglob
	for f in /etc/RedLibre/userteste/*.sh; do
		u=$(basename "$f" .sh)
		[[ -n "$u" && "$u" != "*" ]] && printf '%s\n' "$u"
	done
	shopt -u nullglob
}

_redlibre_drop_colon_user() {
	local file="$1" user="$2" tmp
	[[ -f "$file" && -n "$user" ]] || return 0
	tmp=$(mktemp) || return 1
	awk -F: -v u="$user" '$1 != u { print }' "$file" >"$tmp" && cat "$tmp" >"$file"
	rm -f "$tmp"
}

_redlibre_drop_group_member() {
	local file="$1" user="$2" tmp
	[[ -f "$file" && -n "$user" ]] || return 0
	tmp=$(mktemp) || return 1
	awk -F: -v u="$user" -v OFS=: '
		$1 == u { next }
		{
			n = split($4, a, ",")
			out = ""
			for (i = 1; i <= n; i++) {
				if (a[i] != "" && a[i] != u)
					out = (out == "" ? a[i] : out "," a[i])
			}
			$4 = out
			print
		}
	' "$file" >"$tmp" && cat "$tmp" >"$file"
	rm -f "$tmp"
}

_redlibre_strip_pruebas_from_stage() {
	local stage="$1" u d tmp
	[[ -n "$stage" && -d "$stage" ]] || return 0
	shopt -s nullglob
	while IFS= read -r u; do
		[[ -z "$u" ]] && continue
		if [[ -f "$stage/root/usuarios.db" ]]; then
			tmp=$(mktemp) || continue
			awk -v usr="$u" '$1 != usr { print }' "$stage/root/usuarios.db" >"$tmp" && cat "$tmp" >"$stage/root/usuarios.db"
			rm -f "$tmp"
		fi
		_redlibre_drop_colon_user "$stage/etc/passwd" "$u"
		_redlibre_drop_colon_user "$stage/etc/shadow" "$u"
		_redlibre_drop_group_member "$stage/etc/group" "$u"
		_redlibre_drop_group_member "$stage/etc/gshadow" "$u"
		rm -f "$stage/etc/RedLibre/senha/$u" "$stage/etc/RedLibre/vence/$u"
		for d in "$stage/etc/RedLibre/revendedores"/*; do
			[[ -d "$d" ]] && rm -f "$d/usuarios/$u"
		done
		rm -f "$stage/etc/bot/info-users/$u"
		for d in "$stage/etc/bot/revenda"/* "$stage/etc/bot/suspensos"/*; do
			[[ -d "$d" ]] && rm -f "$d/usuarios/$u"
		done
	done < <(_redlibre_list_pruebas)
	shopt -u nullglob
}

_redlibre_create_backup() {
	# $1 = archivo destino  $2 = "bot" para incluir /etc/bot
	local dest="$1" extra_bot="" stage items=""
	[[ -n "$dest" ]] || dest="/root/backup.vps"
	[[ "${2:-}" = "bot" && -d /etc/bot ]] && extra_bot=1
	stage=$(mktemp -d) || return 1
	mkdir -p "$stage/root" "$stage/etc/RedLibre" "$stage/etc/sudoers.d" "$stage/etc/ssh/sshd_config.d"

	[[ -f /root/usuarios.db ]] && cp -a /root/usuarios.db "$stage/root/usuarios.db"
	cp -a /etc/shadow "$stage/etc/shadow" 2>/dev/null || true
	cp -a /etc/passwd "$stage/etc/passwd" 2>/dev/null || true
	cp -a /etc/group "$stage/etc/group" 2>/dev/null || true
	[[ -f /etc/gshadow ]] && cp -a /etc/gshadow "$stage/etc/gshadow"
	[[ -d /etc/RedLibre/senha ]] && cp -a /etc/RedLibre/senha "$stage/etc/RedLibre/senha"
	[[ -d /etc/RedLibre/vence ]] && cp -a /etc/RedLibre/vence "$stage/etc/RedLibre/vence"
	[[ -d /etc/RedLibre/revendedores ]] && cp -a /etc/RedLibre/revendedores "$stage/etc/RedLibre/revendedores"
	[[ -f /etc/sudoers.d/redlibre-revendedores ]] && cp -a /etc/sudoers.d/redlibre-revendedores "$stage/etc/sudoers.d/"
	[[ -f /etc/ssh/sshd_config.d/50-redlibre-revendedores.conf ]] && cp -a /etc/ssh/sshd_config.d/50-redlibre-revendedores.conf "$stage/etc/ssh/sshd_config.d/"
	[[ -n "$extra_bot" ]] && cp -a /etc/bot "$stage/etc/bot"

	_redlibre_strip_pruebas_from_stage "$stage"

	[[ -e "$stage/root/usuarios.db" ]] && items="$items root/usuarios.db"
	[[ -e "$stage/etc/shadow" ]] && items="$items etc/shadow"
	[[ -e "$stage/etc/passwd" ]] && items="$items etc/passwd"
	[[ -e "$stage/etc/group" ]] && items="$items etc/group"
	[[ -e "$stage/etc/gshadow" ]] && items="$items etc/gshadow"
	[[ -d "$stage/etc/RedLibre/senha" ]] && items="$items etc/RedLibre/senha"
	[[ -d "$stage/etc/RedLibre/vence" ]] && items="$items etc/RedLibre/vence"
	[[ -d "$stage/etc/RedLibre/revendedores" ]] && items="$items etc/RedLibre/revendedores"
	[[ -e "$stage/etc/sudoers.d/redlibre-revendedores" ]] && items="$items etc/sudoers.d/redlibre-revendedores"
	[[ -e "$stage/etc/ssh/sshd_config.d/50-redlibre-revendedores.conf" ]] && items="$items etc/ssh/sshd_config.d/50-redlibre-revendedores.conf"
	[[ -d "$stage/etc/bot" ]] && items="$items etc/bot"

	rm -f "$dest" >/dev/null 2>&1
	# shellcheck disable=SC2086
	tar -C "$stage" -cf "$dest" $items >/dev/null 2>&1
	rm -rf "$stage"
}

_redlibre_restore_revendedores() {
	mkdir -p /etc/RedLibre/senha /etc/RedLibre/vence /etc/RedLibre/revendedores 2>/dev/null || true
	if [[ -f /etc/sudoers.d/redlibre-revendedores ]]; then
		chmod 440 /etc/sudoers.d/redlibre-revendedores 2>/dev/null || true
	fi
	if [[ -x /bin/gestor-revendedores ]] && grep -q -- '--after-restore' /bin/gestor-revendedores 2>/dev/null; then
		/bin/gestor-revendedores --after-restore >/dev/null 2>&1 || true
	else
		[[ -x /bin/revendedor-sshd-lock ]] && /bin/revendedor-sshd-lock >/dev/null 2>&1 || true
		[[ -x /bin/revendedor-caducidad-apply ]] && /bin/revendedor-caducidad-apply >/dev/null 2>&1 || true
	fi
}

clear
backbot=$1
[[ "$backbot" = "botfile" ]] && {
	_redlibre_create_backup /root/backup.vps bot
	exit
}
[[ -z $backbot ]] && {
	IP=$(wget -qO- ipv4.icanhazip.com)
	apchon () {
		_webok=
		command -v ss &>/dev/null && _webok=$(ss -nltp 2>/dev/null | grep -E 'dropbear|:80') || _webok=$(netstat -nltp 2>/dev/null | grep -E 'dropbear|:80')
		[[ ! -d /var/www/html ]] && mkdir -p /var/www/html
		[[ ! -d /var/www/html/backup ]] && mkdir -p /var/www/html/backup
		touch /var/www/html/backup/index.html
		if command -v systemctl &>/dev/null && systemctl is-active --quiet httpd 2>/dev/null; then
			systemctl restart httpd 2>/dev/null
		elif [[ -x /etc/init.d/apache2 ]]; then
			[[ -n "$_webok" ]] || (command -v apt-get &>/dev/null && apt-get install -y apache2 zip 2>/dev/null; sed -i "s/Listen 80/Listen 81/g" /etc/apache2/ports.conf 2>/dev/null)
			/etc/init.d/apache2 restart 2>/dev/null
		elif command -v dnf &>/dev/null; then
			dnf install -y httpd zip 2>/dev/null
			chmod -R 755 /var/www 2>/dev/null
			systemctl enable --now httpd 2>/dev/null
		else
			apt-get install -y apache2 zip 2>/dev/null
			sed -i "s/Listen 80/Listen 81/g" /etc/apache2/ports.conf 2>/dev/null
			service apache2 restart 2>/dev/null
		fi
		chmod -R 755 /var/www 2>/dev/null || true
	}
	fun_temp () {
		helice () {
			apchon > /dev/null 2>&1 & 
			tput civis
			while [ -d /proc/$! ]
			do
				for i in / - \\ \|
				do
					sleep .1
					echo -ne "\e[1D$i"
				done
			done
			tput cnorm
		}
		echo -ne "\033[1;33mAGUARDE\033[1;31m.\033[1;32m.\033[1;33m. \033[1;32m"
		helice
		echo -e "\e[1DOk"
	}
	geralink () {
		if [ -d /var/www/html/backup ]; then
			rm -rf /var/www/html/backup/backup.vps > /dev/null 2>&1
			cp $HOME/backup.vps /var/www/html/backup/backup.vps
			sleep 2
		fi
	}
	fun_temp2 () {
		helice () {
			geralink > /dev/null 2>&1 & 
			tput civis
			while [ -d /proc/$! ]
			do
				for i in / - \\ \|
				do
					sleep .1
					echo -ne "\e[1D$i"
				done
			done
			tput cnorm
		}
		echo -ne "\033[1;33mGERANDO LINK\033[1;31m.\033[1;32m.\033[1;33m. \033[1;32m"
		helice
		echo -e "\e[1DOk"
	}
	echo -e "\E[44;1;37m             Gerenciador De Backups              \E[0m"
	echo ""
	echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mCRIAR BACKUP"
	echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mRESTAURAR BACKUP"
	echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mVOLTAR\033[1;37m"
	echo ""
	echo -ne "\033[1;32mOQUE DESEJA FAZER\033[1;31m ?\033[1;37m : "; read opcao
	if [[ "$opcao" = '1' ]]; then
		if [ -f "/root/usuarios.db" ]
		then
			rm -rf $HOME/backup.vps > /dev/null 2>&1
			sleep 1
			_redlibre_create_backup /root/backup.vps
			echo ""
			echo -e "\033[1;32mBACKUP CRIADO COM SUCESSO !\033[0m"
			echo -e "\033[1;37m(Incluye usuarios.db, shadow, senha/, vence/ y revendedores/; omite usuarios de prueba)\033[0m"
			echo ""
			echo -ne "\033[1;32mGERAR LINK PARA DOWNLOAD \033[1;31m? \033[1;33m[s/n]:\033[1;37m "; read resp
			if [[ "$resp" = "s" ]]; then
				echo ""
				fun_temp
				echo ""
				fun_temp2
				echo ""
				if [ -e /var/www/html/backup/backup.vps ]; then
					if [[ "$VERSION_ID" = 'VERSION_ID="14.04"' ]]; then
						echo -e "\033[1;32mLINK\033[1;37m: \033[1;36m$IP:81/html/backup/backup.vps\033[0m"
					else
						echo -e "\033[1;32mLINK\033[1;37m: \033[1;36m$IP:81/backup/backup.vps\033[0m"
					fi
				else
					echo -e "\033[1;32mDisponivel em\033[1;31m" ~/"backup.vps\033[0m"
				fi
			else
				echo -e "\n\033[1;32mDisponivel em\033[1;31m" ~/"backup.vps\033[0m"
				sleep 2
				menu
			fi
		else
			echo ""
			echo -e "\033[1;32mCriando backup...\033[0m"
			echo ""
			_redlibre_create_backup /root/backup.vps
			sleep 2s
			echo ""
			echo -e "\033[1;33mO Arquivo \033[1;32mbackup.vps"
			echo -e "\033[1;33mfoi criado com sucesso no diretório \033[1;31m/root\033[0m"
			echo -e "\033[1;37m(Incluye shadow, senha/, vence/ y revendedores/; omite usuarios de prueba)\033[0m"
			echo ""
		fi
	fi
	if [[ "$opcao" = '2' ]]; then
		if [ -f "/root/backup.vps" ]
		then
			echo ""
			echo -e "\033[1;36mRestaurando backup..."
			echo ""
			sleep 2s
			cp /root/backup.vps /backup.vps
			cd /
			tar -xvf backup.vps
			rm /backup.vps
			[[ -x /bin/vence-migrar ]] && /bin/vence-migrar --quiet 2>/dev/null || true
			_redlibre_restore_revendedores
			echo ""
			echo -e "\033[1;36mUsuários, senhas e configurações de revendedores importados com sucesso.\033[0m"
			echo -e "\033[1;37m(Los usuarios de prueba no forman parte del respaldo.)\033[0m"
			echo ""
			exit
		else
			echo ""
			echo -e "\033[1;33mO arquivo \033[1;32mbackup.vps \033[1;33mnão foi encontrado!\033[0m"
			echo -e "\033[1;33mCeritifique-se que ele esteja localizado no diretório /root/ com o nome \033[1;32mbackup.vps\033[0m"
			echo ""
			exit
		fi
	fi
	if [[ "$opcao" = '3' ]]; then
		menu
	fi
} || {
	_redlibre_create_backup /root/backup.vps bot
	[[ -d "/etc/RedLibre/backups" ]] && mv /root/backup.vps /etc/RedLibre/backups/backup.vps
	exit
}
