#!/bin/bash
#====================================================
# Ancho de banda por usuario SSH (tc HTB + iptables owner)
# Máximo / sostenida / penalización tras ráfaga
# CLI: apply | watch | hook-add USER | hook-del USER | restore
#====================================================
set +e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin${PATH:+:$PATH}"

BDIR="/etc/RedLibre/banda"
UDIR="$BDIR/usuarios"
SDIR="$BDIR/state"
DEF="$BDIR/default.conf"
FLAG="$BDIR/enabled"
CHAIN="REDLIBRE_BW"
LOGF="/var/log/redlibre-banda.log"
SVC="/etc/systemd/system/redlibre-banda.service"
BWCONF="/etc/RedLibre/bandwidth.conf"
WATCH_SEC=20

# Plantilla (ejemplo pedido: máx 30, sostenida 5, penalización 3 tras 10 min)
MAX_DEFAULT=30
SUS_DEFAULT=5
PEN_DEFAULT=3
BURST_DEFAULT=10
PMIN_DEFAULT=10

_py_log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGF"; }

_pause() { echo -ne "\033[1;33m[ENTER]\033[0m "; read -r; }

_detect_dev() {
	ip -4 route show default 0.0.0.0/0 2>/dev/null | awk '{print $5}' | head -1
}

_tc() { command -v tc >/dev/null && tc "$@" || /usr/sbin/tc "$@"; }

_ensure_tc() {
	command -v tc >/dev/null 2>&1 && return 0
	[[ -x /usr/sbin/tc ]] && return 0
	if command -v dnf >/dev/null 2>&1; then
		dnf install -y iproute iproute-tc iptables >/dev/null 2>&1
	elif command -v yum >/dev/null 2>&1; then
		yum install -y iproute iproute-tc iptables >/dev/null 2>&1
	elif command -v apt-get >/dev/null 2>&1; then
		apt-get install -y iproute2 iptables >/dev/null 2>&1
	fi
	command -v tc >/dev/null 2>&1 || [[ -x /usr/sbin/tc ]]
}

_load_default() {
	MAX_MBPS=$MAX_DEFAULT
	SUS_MBPS=$SUS_DEFAULT
	PEN_MBPS=$PEN_DEFAULT
	BURST_MIN=$BURST_DEFAULT
	PEN_MIN=$PMIN_DEFAULT
	[[ -f "$DEF" ]] || return 0
	# shellcheck disable=SC1090
	. "$DEF"
	MAX_MBPS="${MAX_MBPS:-$MAX_DEFAULT}"
	SUS_MBPS="${SUS_MBPS:-$SUS_DEFAULT}"
	PEN_MBPS="${PEN_MBPS:-$PEN_DEFAULT}"
	BURST_MIN="${BURST_MIN:-$BURST_DEFAULT}"
	PEN_MIN="${PEN_MIN:-$PMIN_DEFAULT}"
}

_save_default() {
	mkdir -p "$BDIR"
	cat >"$DEF" <<EOF
# Plantilla para usuarios nuevos (Mbps y minutos)
MAX_MBPS=$MAX_MBPS
SUS_MBPS=$SUS_MBPS
PEN_MBPS=$PEN_MBPS
BURST_MIN=$BURST_MIN
PEN_MIN=$PEN_MIN
EOF
}

_load_user() {
	local u="$1"
	_load_default
	[[ -f "$UDIR/$u" ]] || return 1
	# shellcheck disable=SC1090
	. "$UDIR/$u"
	MAX_MBPS="${MAX_MBPS:-$MAX_DEFAULT}"
	SUS_MBPS="${SUS_MBPS:-$SUS_DEFAULT}"
	PEN_MBPS="${PEN_MBPS:-$PEN_DEFAULT}"
	BURST_MIN="${BURST_MIN:-$BURST_DEFAULT}"
	PEN_MIN="${PEN_MIN:-$PMIN_DEFAULT}"
}

_save_user() {
	local u="$1"
	mkdir -p "$UDIR"
	cat >"$UDIR/$u" <<EOF
MAX_MBPS=$MAX_MBPS
SUS_MBPS=$SUS_MBPS
PEN_MBPS=$PEN_MBPS
BURST_MIN=$BURST_MIN
PEN_MIN=$PEN_MIN
EOF
}

_user_uid() { id -u "$1" 2>/dev/null; }

_classid() {
	local uid="$1"
	# 1:UID — UIDs de clientes SSH caben en el minor de HTB
	printf '1:%d' "$uid"
}

_parent_rate() {
	local up=0
	if [[ -f "$BWCONF" ]]; then
		# shellcheck disable=SC1090
		. "$BWCONF"
		up="${UP_MBIT:-0}"
	fi
	if [[ "$up" =~ ^[1-9][0-9]*$ ]]; then
		printf '%s' "$up"
	else
		printf '%s' "10000"
	fi
}

_mangle_flush() {
	iptables -w -t mangle -D OUTPUT -j "$CHAIN" 2>/dev/null || true
	iptables -w -t mangle -F "$CHAIN" 2>/dev/null || true
	iptables -w -t mangle -X "$CHAIN" 2>/dev/null || true
}

_mangle_init() {
	modprobe xt_owner 2>/dev/null || true
	iptables -w -t mangle -N "$CHAIN" 2>/dev/null || iptables -w -t mangle -F "$CHAIN"
	iptables -w -t mangle -C OUTPUT -j "$CHAIN" 2>/dev/null || iptables -w -t mangle -A OUTPUT -j "$CHAIN"
}

_ipt_bytes() {
	local u="$1" line
	line=$(iptables -w -t mangle -v -x -n -L "$CHAIN" 2>/dev/null | grep -F "rlbw:$u" | head -1)
	[[ -n "$line" ]] || { echo 0; return; }
	awk '{print $2}' <<<"$line"
}

_penalized() {
	local u="$1" until=0 now
	now=$(date +%s)
	[[ -f "$SDIR/$u" ]] && until=$(grep -E '^PENALTY_UNTIL=' "$SDIR/$u" 2>/dev/null | cut -d= -f2)
	until="${until:-0}"
	[[ "$until" =~ ^[0-9]+$ ]] || until=0
	[[ "$until" -gt "$now" ]]
}

_write_state_kv() {
	local f="$1" k="$2" v="$3" tmp
	mkdir -p "$(dirname "$f")"
	[[ -f "$f" ]] || : >"$f"
	tmp=$(mktemp)
	grep -v "^${k}=" "$f" >"$tmp" 2>/dev/null || true
	echo "${k}=${v}" >>"$tmp"
	mv "$tmp" "$f"
}

_apply_class() {
	local dev="$1" u="$2" uid cid rate ceil
	uid=$(_user_uid "$u") || return 1
	cid=$(_classid "$uid")
	_load_user "$u" || return 1
	if _penalized "$u"; then
		rate=$PEN_MBPS
		ceil=$PEN_MBPS
	else
		rate=$SUS_MBPS
		ceil=$MAX_MBPS
	fi
	[[ "$rate" -lt 1 ]] && rate=1
	[[ "$ceil" -lt "$rate" ]] && ceil=$rate
	_tc class replace dev "$dev" parent 1:1 classid "$cid" htb rate "${rate}mbit" ceil "${ceil}mbit" prio 1 2>/dev/null \
		|| _tc class add dev "$dev" parent 1:1 classid "$cid" htb rate "${rate}mbit" ceil "${ceil}mbit" prio 1
	_tc filter replace dev "$dev" parent 1: protocol ip prio 1 handle "$uid" fw classid "$cid" 2>/dev/null \
		|| _tc filter add dev "$dev" parent 1: protocol ip prio 1 handle "$uid" fw flowid "$cid"
}

banda_apply() {
	local dev parent u uid
	_ensure_tc || { echo "Sin tc (iproute-tc)."; return 1; }
	mkdir -p "$UDIR" "$SDIR"
	dev=$(_detect_dev)
	[[ -n "$dev" ]] || { echo "Sin interfaz por defecto."; return 1; }
	parent=$(_parent_rate)

	_tc qdisc del dev "$dev" root 2>/dev/null || true
	_tc qdisc add dev "$dev" root handle 1: htb default 10
	_tc class add dev "$dev" parent 1: classid 1:1 htb rate "${parent}mbit" ceil "${parent}mbit"
	_tc class add dev "$dev" parent 1:1 classid 1:10 htb rate "${parent}mbit" ceil "${parent}mbit" prio 0

	_mangle_init
	shopt -s nullglob
	for f in "$UDIR"/*; do
		[[ -f "$f" ]] || continue
		u=$(basename "$f")
		id "$u" &>/dev/null || continue
		uid=$(_user_uid "$u")
		[[ -n "$uid" ]] || continue
		iptables -w -t mangle -A "$CHAIN" -m owner --uid-owner "$u" -m comment --comment "rlbw:$u" -j MARK --set-mark "$uid"
		_apply_class "$dev" "$u"
	done
	shopt -u nullglob
	return 0
}

banda_remove_all() {
	local dev
	dev=$(_detect_dev)
	_mangle_flush
	[[ -n "$dev" ]] && _tc qdisc del dev "$dev" root 2>/dev/null || true
	# Restaurar tope global si existe
	if [[ -x /bin/gestor-banda ]]; then
		/bin/gestor-banda restore >/dev/null 2>&1 || true
	fi
}

_install_watch() {
	cat >"$SVC" <<'UNIT'
[Unit]
Description=RedLibre — ancho de banda por usuario (HTB + penalización)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin
ExecStartPre=/bin/gestor-banda-user apply
ExecStart=/bin/gestor-banda-user watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
	systemctl daemon-reload
	systemctl enable --now redlibre-banda.service >/dev/null 2>&1 || systemctl restart redlibre-banda.service
	touch "$FLAG"
}

_stop_watch() {
	systemctl disable --now redlibre-banda.service 2>/dev/null || true
	rm -f "$FLAG"
}

# ---------- vigilancia ----------
banda_watch() {
	local u f now last_b last_t bytes dt bps win n avg maxb burst penmin samples sf
	mkdir -p "$SDIR"
	_ensure_tc || exit 1
	while true; do
		now=$(date +%s)
		shopt -s nullglob
		for f in "$UDIR"/*; do
			[[ -f "$f" ]] || continue
			u=$(basename "$f")
			id "$u" &>/dev/null || continue
			_load_user "$u" || continue
			bytes=$(_ipt_bytes "$u")
			sf="$SDIR/$u"
			last_b=$(grep -E '^LAST_BYTES=' "$sf" 2>/dev/null | cut -d= -f2)
			last_t=$(grep -E '^LAST_TS=' "$sf" 2>/dev/null | cut -d= -f2)
			last_b="${last_b:-}"
			last_t="${last_t:-}"
			if [[ -n "$last_b" && -n "$last_t" && "$last_t" =~ ^[0-9]+$ && "$bytes" =~ ^[0-9]+$ ]]; then
				dt=$((now - last_t))
				if [[ "$dt" -ge 5 ]]; then
					# bytes son octets; Mbps = bytes*8 / dt / 1e6
					bps=$(awk -v b="$bytes" -v lb="$last_b" -v d="$dt" 'BEGIN{
						db=b-lb; if (db<0) db=0;
						printf "%.3f", (db*8)/(d*1000000)
					}')
					echo "$now $bps" >>"$sf.win"
					# recortar ventana
					win=$((BURST_MIN * 60))
					awk -v cut=$((now - win)) '$1>=cut {print}' "$sf.win" >"$sf.win.tmp" 2>/dev/null
					mv "$sf.win.tmp" "$sf.win" 2>/dev/null || true
				fi
			fi
			_write_state_kv "$sf" LAST_BYTES "$bytes"
			_write_state_kv "$sf" LAST_TS "$now"

			# ¿sigue penalizado?
			if _penalized "$u"; then
				dev=$(_detect_dev)
				[[ -n "$dev" ]] && _apply_class "$dev" "$u"
				continue
			fi
			# ¿hay que penalizar?
			burst=$((BURST_MIN * 60))
			n=$(wc -l <"$sf.win" 2>/dev/null || echo 0)
			n="${n// /}"
			# al menos ~70% de la ventana muestreada
			if [[ "$n" -ge 5 ]]; then
				avg=$(awk '{s+=$2; c++} END{if(c) printf "%.3f", s/c; else print 0}' "$sf.win")
				maxb=$(awk -v m="$MAX_MBPS" 'BEGIN{printf "%.3f", m*0.85}')
				# cobertura temporal
				first=$(head -1 "$sf.win" | awk '{print $1}')
				if [[ -n "$first" && $((now - first)) -ge $((burst * 7 / 10)) ]]; then
					if awk -v a="$avg" -v t="$maxb" 'BEGIN{exit !(a+0>=t+0)}'; then
						penmin=$((PEN_MIN * 60))
						_write_state_kv "$sf" PENALTY_UNTIL "$((now + penmin))"
						: >"$sf.win"
						dev=$(_detect_dev)
						_apply_class "$dev" "$u"
						_py_log "PENALIDAD $u avg=${avg}Mbps >= ${maxb} → ${PEN_MBPS}Mbps durante ${PEN_MIN}min"
						logger -t redlibre-banda "penalidad $u ${avg} Mbps → ${PEN_MBPS} Mbps ${PEN_MIN} min" 2>/dev/null || true
					fi
				fi
			fi

			# fin de penalidad
			until=$(grep -E '^PENALTY_UNTIL=' "$sf" 2>/dev/null | cut -d= -f2)
			until="${until:-0}"
			if [[ "$until" =~ ^[1-9][0-9]*$ && "$now" -ge "$until" ]]; then
				_write_state_kv "$sf" PENALTY_UNTIL 0
				: >"$sf.win"
				dev=$(_detect_dev)
				_apply_class "$dev" "$u"
				_py_log "RESTORE $u a sostenida=${SUS_MBPS} techo=${MAX_MBPS}"
			fi
		done
		shopt -u nullglob
		sleep "$WATCH_SEC"
	done
}

hook_add() {
	local u="$1" dev uid
	[[ -n "$u" ]] || return 0
	[[ -f "$DEF" ]] || return 0
	[[ -f "$FLAG" ]] || return 0
	id "$u" &>/dev/null || return 0
	_load_default
	_save_user "$u"
	# Incremental: no reconstruir todo el HTB (tc qdisc del / dnf pueden colgar el alta de usuarios).
	dev=$(_detect_dev)
	uid=$(_user_uid "$u")
	[[ -n "$dev" && -n "$uid" ]] || return 0
	_mangle_init
	iptables -w -t mangle -C "$CHAIN" -m owner --uid-owner "$u" -j MARK --set-mark "$uid" 2>/dev/null \
		|| iptables -w -t mangle -A "$CHAIN" -m owner --uid-owner "$u" -m comment --comment "rlbw:$u" -j MARK --set-mark "$uid" 2>/dev/null || true
	_apply_class "$dev" "$u" 2>/dev/null || true
	return 0
}

hook_del() {
	local u="$1"
	[[ -n "$u" ]] || return 0
	rm -f "$UDIR/$u" "$SDIR/$u" "$SDIR/$u.win"
	[[ -f "$FLAG" ]] && banda_apply >/dev/null 2>&1 || true
}

# ---------- menú ----------
_ask_int() {
	local label="$1" def="$2" min="$3" max="$4"
	echo -ne "\033[1;32m$label \033[1;37m[$def]\033[1;32m: \033[1;37m"
	read -r _ANS
	_ANS="${_ANS//[[:space:]]/}"
	[[ -z "$_ANS" ]] && _ANS="$def"
	if ! [[ "$_ANS" =~ ^[0-9]+$ ]] || [[ "$_ANS" -lt "$min" ]] || [[ "$_ANS" -gt "$max" ]]; then
		echo -e "\033[1;31mValor inválido; se usa $def.\033[0m"
		_ANS="$def"
	fi
}

_do_defaults() {
	clear
	echo -e "\033[1;32mPlantilla para usuarios nuevos\033[0m"
	echo -e "\033[1;37mEjemplo: máximo 30 · sostenida 5 · penalización 3 tras 10 min a tope.\033[0m"
	echo ""
	_load_default
	_ask_int "Velocidad MÁXIMA (Mbps)" "$MAX_MBPS" 1 1000
	MAX_MBPS="$_ANS"
	_ask_int "Velocidad SOSTENIDA (Mbps)" "$SUS_MBPS" 1 1000
	SUS_MBPS="$_ANS"
	_ask_int "Velocidad de PENALIZACIÓN (Mbps)" "$PEN_MBPS" 1 1000
	PEN_MBPS="$_ANS"
	_ask_int "Minutos a máximo antes de penalizar" "$BURST_MIN" 1 1440
	BURST_MIN="$_ANS"
	_ask_int "Minutos que dura la penalización" "$PEN_MIN" 1 1440
	PEN_MIN="$_ANS"
	[[ "$SUS_MBPS" -gt "$MAX_MBPS" ]] && SUS_MBPS=$MAX_MBPS
	[[ "$PEN_MBPS" -gt "$MAX_MBPS" ]] && PEN_MBPS=$MAX_MBPS
	_save_default
	echo -e "\033[1;32mGuardado en $DEF\033[0m"
	_pause
}

_do_one_user() {
	local u
	clear
	echo -e "\033[1;32mConfigurar un usuario\033[0m"
	echo -ne "\033[1;32mUsuario: \033[1;37m"
	read -r u
	u="${u//[[:space:]]/}"
	if [[ -z "$u" ]] || ! id "$u" &>/dev/null; then
		echo -e "\033[1;31mUsuario inexistente.\033[0m"
		_pause
		return
	fi
	_load_user "$u" || _load_default
	echo ""
	echo -e "\033[1;37mActual: máx=${MAX_MBPS}  sostenida=${SUS_MBPS}  penal=${PEN_MBPS}  ráfaga=${BURST_MIN}min  penaliza=${PEN_MIN}min\033[0m"
	echo ""
	_ask_int "Velocidad MÁXIMA (Mbps)" "$MAX_MBPS" 1 1000
	MAX_MBPS="$_ANS"
	_ask_int "Velocidad SOSTENIDA (Mbps)" "$SUS_MBPS" 1 1000
	SUS_MBPS="$_ANS"
	_ask_int "Velocidad de PENALIZACIÓN (Mbps)" "$PEN_MBPS" 1 1000
	PEN_MBPS="$_ANS"
	_ask_int "Minutos a máximo antes de penalizar" "$BURST_MIN" 1 1440
	BURST_MIN="$_ANS"
	_ask_int "Minutos que dura la penalización" "$PEN_MIN" 1 1440
	PEN_MIN="$_ANS"
	[[ "$SUS_MBPS" -gt "$MAX_MBPS" ]] && SUS_MBPS=$MAX_MBPS
	_save_user "$u"
	rm -f "$SDIR/$u.win"
	_write_state_kv "$SDIR/$u" PENALTY_UNTIL 0
	if [[ -f "$FLAG" ]]; then
		banda_apply && echo -e "\033[1;32mAplicado a $u.\033[0m"
	else
		echo -e "\033[1;33mGuardado. Active la vigilancia (opción 5) para aplicar en la red.\033[0m"
	fi
	_pause
}

_do_apply_all_db() {
	local u
	_load_default
	[[ -f "$DEF" ]] || _save_default
	mkdir -p "$UDIR"
	if [[ -f /root/usuarios.db ]]; then
		while read -r u _; do
			[[ -z "$u" || "$u" == \#* ]] && continue
			id "$u" &>/dev/null || continue
			[[ -f "$UDIR/$u" ]] && continue
			_save_user "$u"
		done </root/usuarios.db
	fi
	banda_apply
	echo -e "\033[1;32mReglas aplicadas.\033[0m"
}

_do_list() {
	local u st avg now until
	clear
	echo -e "\E[44;1;37m  Usuarios y ancho de banda  \E[0m"
	echo ""
	printf "\033[1;33m%-16s %6s %6s %6s %8s %s\033[0m\n" "USUARIO" "MAX" "SOST" "PENAL" "ESTADO" "PROM."
	now=$(date +%s)
	shopt -s nullglob
	for f in "$UDIR"/*; do
		[[ -f "$f" ]] || continue
		u=$(basename "$f")
		_load_user "$u"
		st="normal"
		until=$(grep -E '^PENALTY_UNTIL=' "$SDIR/$u" 2>/dev/null | cut -d= -f2)
		if [[ "${until:-0}" -gt "$now" ]]; then
			st="PENAL"
		fi
		avg=$(awk '{s+=$2;c++} END{if(c) printf "%.1f", s/c; else print "-"}' "$SDIR/$u.win" 2>/dev/null)
		printf "%-16s %6s %6s %6s %8s %s\n" "$u" "$MAX_MBPS" "$SUS_MBPS" "$PEN_MBPS" "$st" "$avg"
	done
	shopt -u nullglob
	echo ""
	if systemctl is-active --quiet redlibre-banda.service 2>/dev/null; then
		echo -e "\033[1;32mVigilancia: ACTIVA\033[0m"
	else
		echo -e "\033[1;31mVigilancia: INACTIVA\033[0m"
	fi
	echo ""
	_pause
}

_do_del_user() {
	local u
	echo -ne "\033[1;32mUsuario a quitar del límite: \033[1;37m"
	read -r u
	u="${u//[[:space:]]/}"
	[[ -z "$u" ]] && return
	hook_del "$u"
	echo -e "\033[1;32mSin límite propio: $u\033[0m"
	_pause
}

# CLI
_cmd="${1-}"
_cmd="${_cmd//$'\r'/}"
case "$_cmd" in
	apply | restore)
		banda_apply
		exit $?
		;;
	watch)
		banda_watch
		exit 0
		;;
	hook-add)
		hook_add "${2-}"
		exit 0
		;;
	hook-del)
		hook_del "${2-}"
		exit 0
		;;
	stop)
		_stop_watch
		banda_remove_all
		exit 0
		;;
	"")
		;;
	*)
		# Nunca abrir el menú interactivo si nos llamaron con un subcomando (p. ej. desde criarusuario).
		exit 0
		;;
esac

[[ $EUID -eq 0 ]] || { echo -e "\033[1;31mEjecute como root.\033[0m"; exit 1; }

while true; do
	clear
	_load_default
	tput setaf 7; tput setab 4; tput bold
	printf '%36s%s%-8s\n' " Ancho de banda por usuario "
	tput sgr0
	echo ""
	echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	echo -e "\033[1;37m  Máximo: puede llegar hasta ese tope.\033[0m"
	echo -e "\033[1;37m  Sostenida: velocidad «normal» (HTB rate).\033[0m"
	echo -e "\033[1;37m  Si usa el máximo durante N minutos → baja a penalización.\033[0m"
	echo -e "\033[1;33m  Plantilla: máx \033[1;37m${MAX_MBPS}\033[1;33m · sost. \033[1;37m${SUS_MBPS}\033[1;33m · penal. \033[1;37m${PEN_MBPS}\033[1;33m Mbps · \033[1;37m${BURST_MIN}\033[1;33m min\033[0m"
	if systemctl is-active --quiet redlibre-banda.service 2>/dev/null; then
		echo -e "\033[1;33m  Vigilancia: \033[1;32mACTIVA\033[0m"
	else
		echo -e "\033[1;33m  Vigilancia: \033[1;31mINACTIVA\033[0m"
	fi
	echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	echo ""
	echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m Plantilla por defecto (nuevos usuarios)"
	echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m Configurar un usuario"
	echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;33m Listar usuarios / estado"
	echo -e "\033[1;31m[\033[1;36m4\033[1;31m]\033[1;33m Aplicar plantilla a quienes no tengan límite"
	echo -e "\033[1;31m[\033[1;36m5\033[1;31m]\033[1;33m Activar vigilancia y aplicar en la red"
	echo -e "\033[1;31m[\033[1;36m6\033[1;31m]\033[1;33m Desactivar y quitar límites por usuario"
	echo -e "\033[1;31m[\033[1;36m7\033[1;31m]\033[1;33m Quitar límite de un usuario"
	echo -e "\033[1;31m[\033[1;36m0\033[1;31m]\033[1;33m Volver"
	echo ""
	echo -ne "\033[1;32mOpción: \033[1;37m"
	read -r op
	case "$op" in
		1) _do_defaults ;;
		2) _do_one_user ;;
		3) _do_list ;;
		4) _do_apply_all_db; _pause ;;
		5)
			_load_default
			[[ -f "$DEF" ]] || _save_default
			_do_apply_all_db
			_install_watch
			echo -e "\033[1;32mServicio redlibre-banda activo.\033[0m"
			_pause
			;;
		6)
			_stop_watch
			banda_remove_all
			echo -e "\033[1;32mLímites por usuario desactivados.\033[0m"
			_pause
			;;
		7) _do_del_user ;;
		0 | 00 | "") exit 0 ;;
		*) echo -e "\033[1;31mOpción no válida.\033[0m"; sleep 1 ;;
	esac
done
