#!/bin/bash
#====================================================
# Prueba de velocidad — panel RedLibre (opción 11)
# Soporta Ookla speedtest (JSON) y speedtest-cli (JSON/texto)
#====================================================
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin"

_line() { echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"; }

_pause() {
	echo ""
	echo -ne "\033[1;31mENTER \033[1;33mpara volver al \033[1;32mMENÚ\033[0m: "
	read -r _
}

# Evitar llamarnos a nosotros mismos (/bin/speedtest es este script).
_find_engine() {
	local p
	for p in /usr/bin/speedtest-cli /usr/local/bin/speedtest-cli; do
		[[ -x "$p" ]] && { printf '%s|cli\n' "$p"; return 0; }
	done
	for p in /usr/bin/speedtest /usr/local/bin/speedtest /usr/sbin/speedtest; do
		[[ -x "$p" ]] || continue
		[[ "$(readlink -f "$p" 2>/dev/null || echo "$p")" == "$(readlink -f "$0" 2>/dev/null || echo "$0")" ]] && continue
		if "$p" --version 2>&1 | grep -qi ookla; then
			printf '%s|ookla\n' "$p"
			return 0
		fi
		if "$p" --help 2>&1 | grep -q -- '--json'; then
			printf '%s|cli\n' "$p"
			return 0
		fi
		printf '%s|ookla\n' "$p"
		return 0
	done
	if command -v python3 >/dev/null 2>&1 && python3 -c 'import speedtest' 2>/dev/null; then
		printf 'python3|pymod\n'
		return 0
	fi
	return 1
}

_try_install() {
	echo -e "\033[1;33mNo hay cliente de Speedtest. Intentando instalar speedtest-cli...\033[0m"
	if command -v dnf >/dev/null 2>&1; then
		dnf install -y speedtest-cli >/dev/null 2>&1
	elif command -v yum >/dev/null 2>&1; then
		yum install -y speedtest-cli >/dev/null 2>&1
	elif command -v apt-get >/dev/null 2>&1; then
		DEBIAN_FRONTEND=noninteractive apt-get install -y speedtest-cli >/dev/null 2>&1
	fi
	_find_engine >/dev/null
}

_bar() {
	# $1 = Mbps (float/int)  $2 = escala (default 1000)
	local mbps="${1:-0}" scale="${2:-1000}" n i filled empty
	n=$(awk -v v="$mbps" -v s="$scale" 'BEGIN{
		if (s<=0) s=1000;
		p=v/s*20;
		if (p<0) p=0;
		if (p>20) p=20;
		printf "%d", p+0.5
	}')
	filled=$(printf '%*s' "$n" '' | tr ' ' '#')
	empty=$(printf '%*s' $((20 - n)) '' | tr ' ' '-')
	printf '%s' "${filled}${empty}"
}

_fmt() {
	awk -v v="${1:-0}" 'BEGIN{printf "%.2f", v+0}'
}

_parse_json() {
	python3 - "$1" <<'PY'
import json, sys, shlex
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        raw = fh.read()
    start = raw.find("{")
    if start < 0:
        sys.exit(2)
    d = json.loads(raw[start:])
except Exception:
    sys.exit(2)
ping = jit = down = up = 0
isp = server = city = ip = url = ""
if isinstance(d.get("download"), dict):
    bw = d.get("download", {}).get("bandwidth") or 0
    uw = d.get("upload", {}).get("bandwidth") or 0
    down = bw * 8 / 1e6
    up = uw * 8 / 1e6
    ping = (d.get("ping") or {}).get("latency") or 0
    jit = (d.get("ping") or {}).get("jitter") or 0
    isp = d.get("isp") or ""
    srv = d.get("server") or {}
    server = srv.get("name") or srv.get("host") or ""
    city = srv.get("location") or srv.get("country") or ""
    ip = (d.get("interface") or {}).get("externalIp") or ""
    url = (d.get("result") or {}).get("url") or ""
else:
    down = (d.get("download") or 0) / 1e6
    up = (d.get("upload") or 0) / 1e6
    ping = d.get("ping") or 0
    cli = d.get("client") or {}
    srv = d.get("server") or {}
    isp = cli.get("isp") or ""
    ip = cli.get("ip") or ""
    server = srv.get("sponsor") or srv.get("host") or ""
    city = srv.get("name") or srv.get("country") or ""
    url = d.get("share") or ""
def emit(k, v):
    print("%s=%s" % (k, shlex.quote(str(v).replace("\n", " ").replace("\r", ""))))
emit("PING", ping)
emit("JITTER", jit)
emit("DOWN", down)
emit("UP", up)
emit("ISP", isp)
emit("SERVER", server)
emit("CITY", city)
emit("IP", ip)
emit("URL", url)
PY
}

_parse_text() {
	local f="$1"
	PING=$(grep -iE 'Hosted by|Idle Latency|Latency:' "$f" | head -1 | grep -oE '[0-9]+([.][0-9]+)?[[:space:]]*ms' | head -1 | grep -oE '[0-9]+([.][0-9]+)?')
	DOWN=$(grep -iE '^[[:space:]]*Download:' "$f" | head -1 | grep -oE '[0-9]+([.][0-9]+)?' | head -1)
	UP=$(grep -iE '^[[:space:]]*Upload:' "$f" | head -1 | grep -oE '[0-9]+([.][0-9]+)?' | head -1)
	URL=$(grep -iE 'Share results:|Result URL:' "$f" | head -1 | grep -oE 'https?://[^[:space:]]+' | head -1)
	SERVER=$(grep -iE 'Hosted by|Server:' "$f" | head -1 | sed -E 's/.*Hosted by[[:space:]]+//;s/.*Server:[[:space:]]+//;s/\[[^]]+\]//;s/:[[:space:]]*[0-9].*//')
	ISP=$(grep -iE 'Testing from|ISP:' "$f" | head -1 | sed -E 's/.*Testing from[[:space:]]+//;s/.*ISP:[[:space:]]+//;s/[[:space:]]*\(.*//')
	JITTER=""
	CITY=""
	IP=$(grep -oE 'Testing from.*\([0-9.]+\)' "$f" | grep -oE '[0-9]+(\.[0-9]+){3}' | head -1)
}

_spinner() {
	local pid="$1"
	local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
	local i=0
	tput civis 2>/dev/null || true
	while kill -0 "$pid" 2>/dev/null; do
		printf '\r  \033[1;36m%s\033[0m  \033[1;37mMidiendo ping, bajada y subida…\033[0m   ' "${frames[i]}"
		i=$(((i + 1) % ${#frames[@]}))
		sleep 0.12
	done
	printf '\r%*s\r' 60 ''
	tput cnorm 2>/dev/null || true
}

_show() {
	local fecha escala dbar ubar
	fecha=$(date '+%d/%m/%Y  %H:%M:%S')
	PING="${PING:-—}"
	DOWN="${DOWN:-0}"
	UP="${UP:-0}"
	escala=$(awk -v a="$DOWN" -v b="$UP" 'BEGIN{
		m=a; if(b>m)m=b;
		if(m<=100) print 100;
		else if(m<=250) print 250;
		else if(m<=500) print 500;
		else if(m<=1000) print 1000;
		else print 2500
	}')
	dbar=$(_bar "$DOWN" "$escala")
	ubar=$(_bar "$UP" "$escala")

	clear
	echo ""
	tput setaf 7; tput setab 4; tput bold
	printf '%36s%s%-10s\n' " Prueba de velocidad "
	tput sgr0
	echo ""
	_line
	echo -e "  \033[1;36mResultado del servidor\033[0m  \033[1;37m$fecha\033[0m"
	_line
	echo ""
	[[ -n "$SERVER" ]] && echo -e "  \033[1;33mServidor\033[0m     \033[1;37m${SERVER}${CITY:+ — $CITY}\033[0m"
	[[ -n "$ISP" ]]    && echo -e "  \033[1;33mOperador\033[0m     \033[1;37m$ISP\033[0m"
	[[ -n "$IP" ]]     && echo -e "  \033[1;33mIP pública\033[0m   \033[1;37m$IP\033[0m"
	echo ""
	if [[ "$PING" == "—" || -z "$PING" ]]; then
		echo -e "  \033[1;36mLatencia\033[0m     \033[1;37m—\033[0m"
	elif [[ -n "$JITTER" && "$JITTER" != "0" && "$JITTER" != "0.0" ]]; then
		echo -e "  \033[1;36mLatencia\033[0m     \033[1;37m$(_fmt "$PING") ms\033[0m   \033[1;90mjitter $(_fmt "$JITTER") ms\033[0m"
	else
		echo -e "  \033[1;36mLatencia\033[0m     \033[1;37m$(_fmt "$PING") ms\033[0m"
	fi
	echo ""
	echo -e "  \033[1;32mBajada\033[0m       \033[1;37m$(_fmt "$DOWN")\033[0m \033[1;32mMbps\033[0m"
	echo -e "  \033[1;32m[\033[1;37m$dbar\033[1;32m]\033[0m  \033[1;90mescala ${escala} Mbps\033[0m"
	echo ""
	echo -e "  \033[1;35mSubida\033[0m       \033[1;37m$(_fmt "$UP")\033[0m \033[1;35mMbps\033[0m"
	echo -e "  \033[1;35m[\033[1;37m$ubar\033[1;35m]\033[0m"
	echo ""
	if [[ -n "$URL" ]]; then
		echo -e "  \033[1;33mResultado\033[0m    \033[1;36m$URL\033[0m"
	fi
	_line
	echo ""
}

clear
echo ""
_line
echo -e "  \033[1;36mRedLibre\033[0m  ·  \033[1;37mprueba de velocidad del VPS\033[0m"
_line
echo ""

_eng=$(_find_engine || true)
if [[ -z "$_eng" ]]; then
	_try_install || true
	_eng=$(_find_engine || true)
fi
if [[ -z "$_eng" ]]; then
	echo -e "\033[1;31mNo se encontró un cliente de Speedtest.\033[0m"
	echo -e "\033[1;37mInstale uno de estos:\033[0m"
	echo "  dnf install -y speedtest-cli"
	echo "  (o el cliente oficial Ookla: speedtest)"
	_pause
	exit 1
fi

_bin="${_eng%%|*}"
_kind="${_eng##*|}"
_tmp=$(mktemp) || exit 1
_out=$(mktemp) || { rm -f "$_tmp"; exit 1; }

echo -e "  \033[1;37mMotor:\033[0m \033[1;33m${_kind}\033[0m  \033[1;90m($_bin)\033[0m"
echo ""

(
	if [[ "$_kind" = "ookla" ]]; then
		"$_bin" --accept-license --accept-gdpr --format=json --progress=no >"$_tmp" 2>"$_out" \
			|| "$_bin" --accept-license --accept-gdpr -f json --progress=no >"$_tmp" 2>"$_out"
	elif [[ "$_kind" = "pymod" ]]; then
		python3 -m speedtest --json --share >"$_tmp" 2>"$_out"
	else
		"$_bin" --json --share >"$_tmp" 2>"$_out" || "$_bin" --json >"$_tmp" 2>"$_out"
	fi
) &
_spid=$!
_spinner "$_spid"
wait "$_spid"
_rc=$?

PING=""; JITTER=""; DOWN=""; UP=""; ISP=""; SERVER=""; CITY=""; IP=""; URL=""
_kv=""
if [[ -s "$_tmp" ]] && command -v python3 >/dev/null 2>&1; then
	_kv=$(_parse_json "$_tmp" 2>/dev/null) || _kv=""
fi
if [[ -n "$_kv" ]]; then
	eval "$_kv"
else
	[[ -s "$_out" ]] && cat "$_out" >>"$_tmp"
	_parse_text "$_tmp"
fi

if [[ -z "$DOWN" || "$DOWN" = "0" ]] && [[ -z "$UP" || "$UP" = "0" ]]; then
	clear
	echo ""
	echo -e "\033[1;31mLa prueba no devolvió datos.\033[0m"
	echo ""
	if [[ -s "$_out" ]]; then
		echo -e "\033[1;33mDetalle:\033[0m"
		sed 's/^/  /' "$_out" | tail -20
	elif [[ -s "$_tmp" ]]; then
		echo -e "\033[1;33mSalida:\033[0m"
		sed 's/^/  /' "$_tmp" | tail -20
	fi
	rm -f "$_tmp" "$_out"
	_pause
	exit 1
fi

rm -f "$_tmp" "$_out" "$HOME/speed" 2>/dev/null || true
_show
# Si nos llama el menú (opción 11), él pide ENTER. En ejecución directa, pausamos.
if [[ -z "${RL_SPEEDTEST_NOPAUSE:-}" ]]; then
	_pause
fi
exit 0
