#!/bin/bash
# Cuenta usuarios (UID >= 1000) ya vencidos y escribe /etc/RedLibre/Exp.
# Optimizado: primero /etc/RedLibre/vence/* (solo lectura de archivos);
# chage solo para cuentas sin vence. Bloqueo fino sin pkill repetido.
[[ -d /etc/RedLibre ]] || mkdir -p /etc/RedLibre
[[ -f /etc/RedLibre/redlibre-vence-common ]] && . /etc/RedLibre/redlibre-vence-common
[[ -d /etc/RedLibre/vence ]] || mkdir -p /etc/RedLibre/vence 2>/dev/null || true

userexp=0
_now=$(date +%s)
declare -A _seen=()

# 1) Usuarios con archivo vence (camino rápido)
shopt -s nullglob
for _vf in /etc/RedLibre/vence/*; do
    [[ -f "$_vf" ]] || continue
    _user=$(basename "$_vf")
    [[ -z "$_user" || "$_user" == "root" || "$_user" == "*" ]] && continue
    id "$_user" &>/dev/null || continue
    _uid=$(id -u "$_user" 2>/dev/null) || continue
    [[ "$_uid" -ge 1000 ]] || continue
    _seen["$_user"]=1

    _raw=$(tr -d '\r' <"$_vf" | head -1)
    _raw="${_raw#"${_raw%%[![:space:]]*}"}"
    _raw="${_raw%"${_raw##*[![:space:]]}"}"
    [[ -n "$_raw" ]] || continue
    _cut=$(date +%s --date="$_raw" 2>/dev/null || date +%s -d "$_raw" 2>/dev/null) || continue
    [[ "$_now" -ge "$_cut" ]] || continue
    userexp=$((userexp + 1))
    if declare -F redlibre_vence_lock_if_due >/dev/null 2>&1; then
        redlibre_vence_lock_if_due "$_user" || true
    fi
done
shopt -u nullglob

# 2) Legacy sin vence: un chage por usuario (cada vez menos tras migrar)
while IFS= read -r _user; do
    [[ -z "$_user" || "$_user" == "root" ]] && continue
    [[ -n "${_seen[$_user]:-}" ]] && continue

    exp_line=$(LANG=en_US.UTF-8 chage -l "$_user" 2>/dev/null | awk -F: '/Account expires/{print $2}' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$exp_line" || "$exp_line" == "never" ]] && continue
    _cut=$(date +%s --date="$exp_line" 2>/dev/null || date +%s -d "$exp_line" 2>/dev/null)
    [[ -z "$_cut" ]] && continue
    [[ "$_now" -ge "$_cut" ]] && userexp=$((userexp + 1))
done < <(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd)

printf '%s\n' "$userexp" >/etc/RedLibre/Exp
