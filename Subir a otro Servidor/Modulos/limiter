#!/bin/bash
# Watcher: corta sesiones SSH/Dropbear que excedan el límite en /root/usuarios.db
# Conteo principal por procesos (sshd / sshd-session); el log solo ayuda a elegir PID a matar.

database="/root/usuarios.db"
if [[ -f /var/log/secure ]]; then
    AUTH_LOG_FILE="/var/log/secure"
elif [[ -f /var/log/auth.log ]]; then
    AUTH_LOG_FILE="/var/log/auth.log"
else
    AUTH_LOG_FILE="/var/log/messages"
fi
LOG_KILL_FILE="/var/log/session_kill.log"

LOG_TAIL_LINES=5000
SLEEP_TIME=10
if [[ -f /etc/RedLibre/limiter.conf ]]; then
    # shellcheck disable=SC1091
    . /etc/RedLibre/limiter.conf
fi
case "${SLEEP_TIME:-}" in
''|*[!0-9]*) SLEEP_TIME=10 ;;
0) SLEEP_TIME=10 ;;
esac
[[ "$SLEEP_TIME" -gt 300 ]] && SLEEP_TIME=300
SLEEP_TIME="${SLEEP_TIME:-10}"

_redlibre_limiter_extract_pids() {
    grep -oE 'dropbear\[[0-9]+\]|sshd-session\[[0-9]+\]|sshd\[[0-9]+\]' 2>/dev/null | sed 's/.*\[\([0-9]*\)\]/\1/' | sort -u
}

# Conteo fiable: procesos del usuario (misma base que PAM / infousers)
get_active_session_count() {
    local target_user="$1"
    local c=0
    c=$(ps -u "$target_user" -o comm= 2>/dev/null | grep -cE '^(sshd|sshd-session|dropbear)$' || true)
    echo "${c:-0}"
}

# PIDs SSH/Dropbear del usuario (más nuevo primero)
_redlibre_user_ssh_pids() {
    local target_user="$1"
    ps -u "$target_user" -o pid=,comm=,etime= 2>/dev/null |
        awk '$2 ~ /^(sshd|sshd-session|dropbear)$/ {print $1}' |
        while read -r pid; do
            [[ -n "$pid" ]] && ps -p "$pid" >/dev/null 2>&1 && echo "$pid"
        done | sort -nr
}

while true; do
    [[ -f "$database" ]] || { sleep "$SLEEP_TIME"; continue; }

    while IFS=' ' read -r user s2ssh _; do
        user=$(echo "$user" | xargs)
        s2ssh=$(echo "$s2ssh" | xargs)

        # Saltar comentarios / cabeceras
        [[ -z "$user" || "$user" == \#* || "$user" == "*" ]] && continue
        [[ -z "$s2ssh" || ! "$s2ssh" =~ ^[0-9]+$ || "$s2ssh" -eq 0 ]] && continue
        id "$user" &>/dev/null || continue

        CURRENT_SESSIONS=$(get_active_session_count "$user")

        if [[ "$CURRENT_SESSIONS" -gt "$s2ssh" ]]; then
            # Preferir PID vivo del usuario; fallback al log de auth
            PID_TO_KILL=$(_redlibre_user_ssh_pids "$user" | head -1)
            if [[ -z "$PID_TO_KILL" && -r "$AUTH_LOG_FILE" ]]; then
                PID_TO_KILL=$(
                    tail -n "$LOG_TAIL_LINES" "$AUTH_LOG_FILE" 2>/dev/null |
                        grep -E 'Accepted password|Password auth succeeded|session opened' |
                        grep -w "$user" |
                        _redlibre_limiter_extract_pids |
                        sort -nr |
                        while read -r pid; do
                            ps -p "$pid" >/dev/null 2>&1 && echo "$pid"
                        done | head -1
                )
            fi

            if [[ -n "$PID_TO_KILL" ]]; then
                kill "$PID_TO_KILL" 2>/dev/null
                echo "$(date): KILLED PID $PID_TO_KILL for user $user. Limit exceeded ($CURRENT_SESSIONS/$s2ssh)" >>"$LOG_KILL_FILE"
            fi
        fi

    done <"$database"

    # Tope global de sesiones por revendedor
    shopt -s nullglob
    for _rev_path in /etc/RedLibre/revendedores/*; do
        [[ -d "$_rev_path/usuarios" ]] || continue
        _max_tot=$(grep -E '^MAX_SESIONES_TOTAL_REVENDEDOR=' "$_rev_path/conf" 2>/dev/null | head -1 | cut -d= -f2)
        _max_tot="${_max_tot//[^0-9]/}"
        [[ -z "$_max_tot" || "$_max_tot" -eq 0 ]] && continue
        _tot=0
        _rev_users=()
        for _mf in "$_rev_path/usuarios"/*; do
            [[ -f "$_mf" ]] || continue
            _un=$(basename "$_mf")
            id "$_un" &>/dev/null || continue
            [[ $(id -u "$_un" 2>/dev/null) -ge 1000 ]] || continue
            _rev_users+=("$_un")
            _c=$(get_active_session_count "$_un")
            _tot=$((_tot + _c))
        done
        if [[ "$_tot" -gt "$_max_tot" ]]; then
            PID_TO_KILL=""
            for _un in "${_rev_users[@]}"; do
                PID_TO_KILL=$(_redlibre_user_ssh_pids "$_un" | head -1)
                [[ -n "$PID_TO_KILL" ]] && break
            done
            if [[ -n "$PID_TO_KILL" ]]; then
                kill "$PID_TO_KILL" 2>/dev/null
                echo "$(date): KILLED PID $PID_TO_KILL reseller global limit ($_tot/$_max_tot) path $_rev_path" >>"$LOG_KILL_FILE"
            fi
        fi
    done
    shopt -u nullglob

    [[ -x /bin/revendedor-caducidad-apply ]] && /bin/revendedor-caducidad-apply

    sleep "$SLEEP_TIME"
done
