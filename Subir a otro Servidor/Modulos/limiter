#!/bin/bash
# Watcher: corta sesiones SSH/Dropbear que excedan /root/usuarios.db
# - Fantasmas (sin TCP) se limpian siempre
# - El límite cuenta solo sesiones con TCP establecido
# - En un ciclo mata TODO el exceso (las más nuevas)
# - Si hay exceso, vuelve a mirar en 1s
set +e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin"

database="/root/usuarios.db"
LOG_KILL_FILE="/var/log/session_kill.log"
SLEEP_TIME=10

_reload_conf() {
	SLEEP_TIME=10
	if [[ -f /etc/RedLibre/limiter.conf ]]; then
		# shellcheck disable=SC1091
		. /etc/RedLibre/limiter.conf
	fi
	case "${SLEEP_TIME:-}" in
	''|*[!0-9]*) SLEEP_TIME=10 ;;
	0) SLEEP_TIME=10 ;;
	esac
	[[ "$SLEEP_TIME" -gt 300 ]] && SLEEP_TIME=300
}

_reload_conf

mkdir -p /var/lock
exec 9>/var/lock/redlibre-limiter.lock
if command -v flock >/dev/null 2>&1; then
	flock -n 9 || exit 0
fi

_ss_dump() {
	ss -H -tnp state established 2>/dev/null || ss -tnp state established 2>/dev/null
}

_has_tcp() {
	printf '%s' "$2" | grep -qE "pid=${1}[,)]"
}

# Líneas "pid etimes" únicas (sshd / sshd-session / dropbear del usuario,
# y dropbear root cuyo args contiene el login).
_pids_user() {
	local u="$1"
	{
		ps -u "$u" -o pid=,comm=,etimes= 2>/dev/null | awk '
			$2=="sshd" || $2=="sshd-session" || $2=="dropbear" {
				print $1, $3+0
			}'
		ps -C dropbear -o pid=,user=,etimes=,args= 2>/dev/null | awk -v u="$u" '
			$2=="root" && $0 ~ "(^|[^[:alnum:]_])" u "([^[:alnum:]_]|$)" { print $1, $3+0 }
		'
	} | awk '!seen[$1]++ { print $1, $2 }'
}

_note() {
	echo "$(date '+%F %T'): $*" >>"$LOG_KILL_FILE"
	logger -t redlibre-limiter -- "$*" 2>/dev/null || true
}

_kill_pid() {
	local pid="$1" why="$2"
	[[ -n "$pid" ]] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	kill -TERM "$pid" 2>/dev/null
	sleep 0.15
	if kill -0 "$pid" 2>/dev/null; then
		kill -KILL "$pid" 2>/dev/null
	fi
	_note "KILLED PID $pid $why"
}

# Orden: ghost=1 primero; etimes bajo = más nuevo.
_sorted_pids() {
	local user="$1" dump="$2" only="$3" # only=ghost|live|all
	local pid et ghost
	while read -r pid et; do
		[[ -z "$pid" ]] && continue
		kill -0 "$pid" 2>/dev/null || continue
		ghost=1
		_has_tcp "$pid" "$dump" && ghost=0
		if [[ "$only" == "ghost" && "$ghost" -eq 0 ]]; then continue; fi
		if [[ "$only" == "live" && "$ghost" -eq 1 ]]; then continue; fi
		printf '%s %010d %s\n' "$ghost" "$et" "$pid"
	done < <(_pids_user "$user") | sort -k1,1nr -k2,2n
}

_count_live() {
	local user="$1" dump="$2" n=0 pid et
	while read -r pid et; do
		[[ -z "$pid" ]] && continue
		kill -0 "$pid" 2>/dev/null || continue
		_has_tcp "$pid" "$dump" && n=$((n + 1))
	done < <(_pids_user "$user")
	echo "$n"
}

_kill_ghosts() {
	local user="$1" dump="$2" pid et ghost
	while read -r ghost et pid; do
		[[ -n "$pid" ]] || continue
		_kill_pid "$pid" "ghost no-tcp user=$user age=${et}s"
	done < <(_sorted_pids "$user" "$dump" ghost)
}

_kill_live_excess() {
	local user="$1" extra="$2" why="$3" dump="$4"
	local n=0 ghost et pid
	[[ "$extra" -gt 0 ]] || return 0
	while read -r ghost et pid; do
		[[ -n "$pid" ]] || continue
		_kill_pid "$pid" "$why (user=$user extra=$extra age=${et}s)"
		n=$((n + 1))
		[[ "$n" -ge "$extra" ]] && break
	done < <(_sorted_pids "$user" "$dump" live)
}

_rotate_log() {
	local sz
	[[ -f "$LOG_KILL_FILE" ]] || return 0
	sz=$(stat -c %s "$LOG_KILL_FILE" 2>/dev/null || echo 0)
	if [[ "$sz" -gt 1048576 ]]; then
		tail -n 400 "$LOG_KILL_FILE" >"${LOG_KILL_FILE}.tmp" 2>/dev/null && mv -f "${LOG_KILL_FILE}.tmp" "$LOG_KILL_FILE"
	fi
}

_last_cad=0

while true; do
	_reload_conf
	_rotate_log
	if [[ ! -f "$database" ]]; then
		sleep "$SLEEP_TIME"
		continue
	fi
	SS_DUMP=$(_ss_dump)
	_did_cut=0

	while IFS=' ' read -r user s2ssh _; do
		user="${user//$'\r'/}"
		s2ssh="${s2ssh//$'\r'/}"
		user="${user//[[:space:]]/}"
		s2ssh="${s2ssh//[[:space:]]/}"

		[[ -z "$user" || "$user" == \#* || "$user" == "*" ]] && continue
		[[ -z "$s2ssh" || ! "$s2ssh" =~ ^[0-9]+$ || "$s2ssh" -eq 0 ]] && continue
		id "$user" &>/dev/null || continue

		_kill_ghosts "$user" "$SS_DUMP"
		CURRENT=$(_count_live "$user" "$SS_DUMP")
		if [[ "$CURRENT" -gt "$s2ssh" ]]; then
			_kill_live_excess "$user" "$((CURRENT - s2ssh))" \
				"limit exceeded ($CURRENT/$s2ssh)" "$SS_DUMP"
			_did_cut=1
		fi
	done <"$database"

	shopt -s nullglob
	for _rev_path in /etc/RedLibre/revendedores/*; do
		[[ -d "$_rev_path/usuarios" ]] || continue
		_max_tot=$(grep -E '^MAX_SESIONES_TOTAL_REVENDEDOR=' "$_rev_path/conf" 2>/dev/null | head -1 | cut -d= -f2)
		_max_tot="${_max_tot//$'\r'/}"
		_max_tot="${_max_tot//[^0-9]/}"
		[[ -z "$_max_tot" || "$_max_tot" -eq 0 ]] && continue
		_tot=0
		_rev_users=()
		for _mf in "$_rev_path/usuarios"/*; do
			[[ -f "$_mf" ]] || continue
			_un=$(basename "$_mf")
			id "$_un" &>/dev/null || continue
			[[ $(id -u "$_un" 2>/dev/null) -ge 1000 ]] || continue
			_rev_users+=("$_un")
			_tot=$((_tot + $(_count_live "$_un" "$SS_DUMP")))
		done
		if [[ "$_tot" -gt "$_max_tot" ]]; then
			_need=$((_tot - _max_tot))
			_did_cut=1
			for _un in "${_rev_users[@]}"; do
				[[ "$_need" -le 0 ]] && break
				_c=$(_count_live "$_un" "$SS_DUMP")
				[[ "$_c" -gt 0 ]] || continue
				_take=$_c
				[[ "$_take" -gt "$_need" ]] && _take=$_need
				_kill_live_excess "$_un" "$_take" \
					"reseller global ($_tot/$_max_tot)" "$SS_DUMP"
				_need=$((_need - _take))
			done
		fi
	done
	shopt -u nullglob

	_now=$(date +%s)
	if [[ -x /bin/revendedor-caducidad-apply ]] && ((_now - _last_cad >= 60)); then
		/bin/revendedor-caducidad-apply >/dev/null 2>&1 || true
		_last_cad=$_now
	fi

	if [[ "$_did_cut" -eq 1 ]]; then
		sleep 1
	else
		sleep "$SLEEP_TIME"
	fi
done
