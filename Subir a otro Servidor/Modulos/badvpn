#!/bin/bash
#====================================================
# Gestor UDPGW / udppy — menú opción 17
# Parámetros persistentes en /etc/RedLibre/udppy.conf
#====================================================
[[ $EUID -eq 0 ]] || {
	echo -e "\033[1;31mEjecute como root.\033[0m"
	exit 1
}

UDPPY_DIR="/opt/udppy"
UDPPY_RAW="https://raw.githubusercontent.com/josecarlosmeza/linux/main/udppy"
UDPPY_UNIT="udppy-server"
OLD_PY_UNIT="udpgw-py"
NATIVE_UNIT="badvpn-udpgw"
CONF_DIR="/etc/RedLibre"
CONF_FILE="$CONF_DIR/udppy.conf"

LISTEN_ADDR_DEFAULT="127.0.0.1:7300"
DNS_DEFAULT="8.8.8.8:53"
UDP_MTU_DEFAULT="65520"
MAX_CONNECTIONS_DEFAULT="256"
BACKLOG_DEFAULT="256"

_py() {
	command -v python3 2>/dev/null || echo /usr/bin/python3
}

_pause() {
	echo -ne "\033[1;33m[ENTER]\033[0m "
	read -r
}

_unit_exists() {
	local u="$1"
	[[ -f "/etc/systemd/system/${u}.service" || -f "/usr/lib/systemd/system/${u}.service" ]] && return 0
	systemctl cat "${u}.service" &>/dev/null && return 0
	return 1
}

_load_conf() {
	LISTEN_ADDR="$LISTEN_ADDR_DEFAULT"
	DNS="$DNS_DEFAULT"
	UDP_MTU="$UDP_MTU_DEFAULT"
	MAX_CONNECTIONS="$MAX_CONNECTIONS_DEFAULT"
	BACKLOG="$BACKLOG_DEFAULT"
	VERBOSE=0
	NO_LINUX_TUNE=0
	NO_UVLOOP=0
	if [[ -f "$CONF_FILE" ]]; then
		# shellcheck disable=SC1090
		. "$CONF_FILE"
	fi
	LISTEN_ADDR="${LISTEN_ADDR:-$LISTEN_ADDR_DEFAULT}"
	UDP_MTU="${UDP_MTU:-$UDP_MTU_DEFAULT}"
	MAX_CONNECTIONS="${MAX_CONNECTIONS:-$MAX_CONNECTIONS_DEFAULT}"
	BACKLOG="${BACKLOG:-$BACKLOG_DEFAULT}"
	VERBOSE="${VERBOSE:-0}"
	NO_LINUX_TUNE="${NO_LINUX_TUNE:-0}"
	NO_UVLOOP="${NO_UVLOOP:-0}"
}

_save_conf() {
	mkdir -p "$CONF_DIR"
	cat >"$CONF_FILE" <<EOF
# RedLibre udppy — generado por el menú opción 17
LISTEN_ADDR=$LISTEN_ADDR
DNS=$DNS
UDP_MTU=$UDP_MTU
MAX_CONNECTIONS=$MAX_CONNECTIONS
BACKLOG=$BACKLOG
VERBOSE=$VERBOSE
NO_LINUX_TUNE=$NO_LINUX_TUNE
NO_UVLOOP=$NO_UVLOOP
EOF
	chmod 644 "$CONF_FILE"
}

_listen_port() {
	printf '%s' "${LISTEN_ADDR##*:}"
}

_onoff() {
	[[ "$1" = "1" ]] && echo "sí" || echo "no"
}

_udppy_files_ok() {
	[[ -f "$UDPPY_DIR/udppy_server.py" && -f "$UDPPY_DIR/udppy_proto.py" && -f "$UDPPY_DIR/linux_tune.py" ]] || return 1
	grep -q 'listen-addr' "$UDPPY_DIR/udppy_server.py" 2>/dev/null
}

bad_running() {
	systemctl is-active --quiet "$UDPPY_UNIT" 2>/dev/null && return 0
	pgrep -f 'udppy_server.py' >/dev/null 2>&1 && return 0
	return 1
}

_status_text() {
	if bad_running; then
		printf 'ACTIVO · %s' "$LISTEN_ADDR"
	elif _udppy_files_ok || _unit_exists "$UDPPY_UNIT"; then
		printf 'INSTALADO / INACTIVO'
	else
		printf 'NO INSTALADO'
	fi
}

_listen_ok() {
	local p
	p=$(_listen_port)
	[[ "$p" =~ ^[0-9]+$ ]] || return 1
	if command -v ss &>/dev/null; then
		ss -tln 2>/dev/null | grep -qE ":${p}[[:space:]]"
		return $?
	fi
	netstat -tln 2>/dev/null | grep -qE ":${p}[[:space:]]"
}

_exec_line() {
	local py flags=""
	py=$(_py)
	flags="--listen-addr ${LISTEN_ADDR} --udp-mtu ${UDP_MTU} --max-connections ${MAX_CONNECTIONS} --backlog ${BACKLOG}"
	[[ -n "$DNS" ]] && flags="$flags --dns ${DNS}"
	[[ "$VERBOSE" = "1" ]] && flags="$flags --verbose"
	[[ "$NO_LINUX_TUNE" = "1" ]] && flags="$flags --no-linux-tune"
	[[ "$NO_UVLOOP" = "1" ]] && flags="$flags --no-uvloop"
	printf '%s %s/udppy_server.py %s' "$py" "$UDPPY_DIR" "$flags"
}

_write_unit() {
	local exec
	exec=$(_exec_line)
	cat >"/etc/systemd/system/${UDPPY_UNIT}.service" <<EOF
[Unit]
Description=udppy — túnel UDP compatible con badvpn/udpgw (tun2socks)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=${UDPPY_DIR}
ExecStart=${exec}
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF
	systemctl daemon-reload
}

_apply() {
	_save_conf
	_udppy_files_ok || return 1
	_write_unit
	if bad_running; then
		systemctl restart "$UDPPY_UNIT"
		sleep 1
	fi
	return 0
}

_retire_old_udpgw() {
	systemctl disable --now "$OLD_PY_UNIT" 2>/dev/null || true
	systemctl stop "$OLD_PY_UNIT" 2>/dev/null || true
	rm -f "/etc/systemd/system/${OLD_PY_UNIT}.service"
	pkill -f 'udpgw_server.py' 2>/dev/null || true
	systemctl disable --now "$NATIVE_UNIT" 2>/dev/null || true
	systemctl stop "$NATIVE_UNIT" 2>/dev/null || true
	pkill -f 'badvpn-udpgw' 2>/dev/null || true
	screen -S udpvpn -X quit 2>/dev/null || true
	systemctl daemon-reload 2>/dev/null || true
}

_ensure_python() {
	command -v python3 >/dev/null 2>&1 && return 0
	if command -v dnf >/dev/null 2>&1; then
		dnf install -y python3 python3-pip >/dev/null 2>&1
	elif command -v yum >/dev/null 2>&1; then
		yum install -y python3 python3-pip >/dev/null 2>&1
	elif command -v apt-get >/dev/null 2>&1; then
		apt-get install -y python3 python3-pip >/dev/null 2>&1
	fi
	command -v python3 >/dev/null 2>&1
}

_fetch() {
	local url="$1" out="$2"
	if command -v wget >/dev/null 2>&1; then
		wget -qO "$out" --timeout=30 --tries=2 "$url"
	elif command -v curl >/dev/null 2>&1; then
		curl -fsSL --max-time 30 -o "$out" "$url"
	else
		return 1
	fi
}

_download_udppy() {
	local f
	mkdir -p "$UDPPY_DIR"
	for f in udppy_server.py udppy_proto.py linux_tune.py; do
		_fetch "${UDPPY_RAW}/${f}" "$UDPPY_DIR/${f}" || return 1
		sed -i 's/\r$//' "$UDPPY_DIR/${f}" 2>/dev/null || true
		chmod 755 "$UDPPY_DIR/${f}" 2>/dev/null || true
	done
	command -v restorecon >/dev/null 2>&1 && restorecon -RF "$UDPPY_DIR" 2>/dev/null || true
	_udppy_files_ok
}

_try_uvloop() {
	local py
	py=$(_py)
	"$py" -c 'import uvloop' >/dev/null 2>&1 && return 0
	"$py" -m pip install -q 'uvloop>=0.17.0' >/dev/null 2>&1 || true
}

_ask_keep() {
	# $1 prompt  $2 current → _ANS (empty = keep)
	local cur="$2"
	echo -ne "\033[1;32m$1 \033[1;37m[${cur}]\033[1;32m: \033[1;37m"
	read -r _ANS
	_ANS="${_ANS#"${_ANS%%[![:space:]]*}"}"
	_ANS="${_ANS%"${_ANS##*[![:space:]]}"}"
	[[ -z "$_ANS" ]] && _ANS="$cur"
}

_valid_hostport() {
	local s="$1"
	[[ "$s" =~ ^[0-9A-Za-z._-]+:[0-9]+$ ]] || [[ "$s" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$ ]]
}

_valid_int() {
	[[ "$1" =~ ^[1-9][0-9]*$ ]]
}

_need_installed() {
	if ! _udppy_files_ok; then
		echo -e "\033[1;31mUDPGW no está instalado. Use la opción 1.\033[0m"
		_pause
		return 1
	fi
	return 0
}

# ---------- acciones ----------
_do_install() {
	clear
	echo -e "\033[1;32mInstalar / actualizar udppy\033[0m\n"
	_load_conf
	_retire_old_udpgw
	if ! _ensure_python; then
		echo -e "\033[1;31mNo hay Python 3 (se requiere 3.9+).\033[0m"
		_pause
		return 1
	fi
	echo -e "\033[1;33mDescargando archivos...\033[0m"
	if ! _download_udppy; then
		echo -e "\033[1;31mNo se pudo descargar udppy desde GitHub.\033[0m"
		echo -e "\033[1;37m$UDPPY_RAW/\033[0m"
		_pause
		return 1
	fi
	_try_uvloop
	_save_conf
	_write_unit
	systemctl enable "$UDPPY_UNIT" >/dev/null 2>&1 || true
	systemctl restart "$UDPPY_UNIT"
	sleep 1
	if bad_running || _listen_ok; then
		echo -e "\n\033[1;32mudppy instalado y activo\033[0m  \033[1;37m($LISTEN_ADDR)\033[0m"
		echo -e "\033[1;37mCliente: payload udpgw $LISTEN_ADDR\033[0m"
	else
		echo -e "\n\033[1;31mArchivos instalados, pero el servicio no arrancó.\033[0m"
		systemctl status "$UDPPY_UNIT" --no-pager -l 2>/dev/null | head -16
	fi
	_pause
}

_do_start() {
	_load_conf
	_need_installed || return 0
	_retire_old_udpgw
	_write_unit
	systemctl enable "$UDPPY_UNIT" >/dev/null 2>&1 || true
	systemctl restart "$UDPPY_UNIT"
	sleep 1
	if bad_running || _listen_ok; then
		echo -e "\033[1;32mIniciado en $LISTEN_ADDR\033[0m"
	else
		echo -e "\033[1;31mNo se pudo iniciar.\033[0m"
		systemctl status "$UDPPY_UNIT" --no-pager -l 2>/dev/null | head -12
	fi
	_pause
}

_do_stop() {
	systemctl disable --now "$UDPPY_UNIT" 2>/dev/null || true
	systemctl stop "$UDPPY_UNIT" 2>/dev/null || true
	pkill -f 'udppy_server.py' 2>/dev/null || true
	echo -e "\033[1;32mServicio detenido (la configuración se conserva).\033[0m"
	_pause
}

_do_restart() {
	_load_conf
	_need_installed || return 0
	_write_unit
	systemctl restart "$UDPPY_UNIT"
	sleep 1
	if bad_running; then
		echo -e "\033[1;32mReiniciado.\033[0m"
	else
		echo -e "\033[1;31mFalló el reinicio.\033[0m"
	fi
	_pause
}

_do_status() {
	clear
	_load_conf
	echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	echo -e "\E[44;1;37m     Estado UDPGW / udppy      \E[0m"
	echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	echo ""
	echo -e "\033[1;33mEstado:     \033[1;37m$(_status_text)\033[0m"
	echo -e "\033[1;33mEscucha:    \033[1;37m$LISTEN_ADDR\033[0m"
	echo -e "\033[1;33mDNS:        \033[1;37m${DNS:-(sin --dns)}\033[0m"
	echo -e "\033[1;33mConex. UDP: \033[1;37m$MAX_CONNECTIONS\033[0m  \033[1;33mMTU:\033[1;37m $UDP_MTU\033[0m  \033[1;33mBacklog:\033[1;37m $BACKLOG\033[0m"
	echo -e "\033[1;33mVerbose:    \033[1;37m$(_onoff "$VERBOSE")\033[0m  \033[1;33mLinux-tune:\033[1;37m $(_onoff "$([[ "$NO_LINUX_TUNE" = "1" ]] && echo 0 || echo 1)")\033[0m  \033[1;33muvloop:\033[1;37m $(_onoff "$([[ "$NO_UVLOOP" = "1" ]] && echo 0 || echo 1)")\033[0m"
	echo -e "\033[1;33mConfig:     \033[1;37m$CONF_FILE\033[0m"
	echo ""
	echo -e "\033[1;33m# systemctl\033[0m"
	systemctl status "$UDPPY_UNIT" --no-pager -l 2>/dev/null | head -n 16 || echo "(sin unidad)"
	echo ""
	echo -e "\033[1;33m# Puerto en escucha\033[0m"
	if command -v ss >/dev/null 2>&1; then
		ss -tlnp 2>/dev/null | grep -E ":$(_listen_port)\\b" || echo "(nada en :$(_listen_port))"
	else
		netstat -tlnp 2>/dev/null | grep -E ":$(_listen_port)\\b" || echo "(nada en :$(_listen_port))"
	fi
	echo ""
	echo -e "\033[1;33m# Últimos logs\033[0m"
	journalctl -u "$UDPPY_UNIT" -n 15 --no-pager 2>/dev/null || echo "(sin journal)"
	echo ""
	_pause
}

_applied_ok() {
	echo -e "\033[1;32mGuardado.\033[0m  \033[1;37m$(_status_text)\033[0m"
	if bad_running; then
		echo -e "\033[1;37mServicio reiniciado con los nuevos parámetros.\033[0m"
	else
		echo -e "\033[1;33mInactivo: use la opción 2 para iniciar.\033[0m"
	fi
	_pause
}

_do_listen() {
	_load_conf
	clear
	echo -e "\033[1;32mDirección de escucha TCP\033[0m"
	echo -e "\033[1;37mEjemplos: 127.0.0.1:7300 (solo túnel SSH)  ·  0.0.0.0:7300 (IP pública)\033[0m"
	echo ""
	_ask_keep "IP:puerto" "$LISTEN_ADDR"
	if ! _valid_hostport "$_ANS"; then
		echo -e "\033[1;31mFormato inválido. Use host:puerto (ej. 127.0.0.1:7300).\033[0m"
		_pause
		return 0
	fi
	LISTEN_ADDR="$_ANS"
	_apply
	_applied_ok
}

_do_dns() {
	_load_conf
	clear
	echo -e "\033[1;32mDNS para reenvío (--dns)\033[0m"
	echo -e "\033[1;37mVacío o 0 = desactivar. Ejemplo: 8.8.8.8:53\033[0m"
	echo ""
	echo -ne "\033[1;32mDNS \033[1;37m[${DNS:-(off)}]\033[1;32m: \033[1;37m"
	read -r _ANS
	_ANS="${_ANS#"${_ANS%%[![:space:]]*}"}"
	_ANS="${_ANS%"${_ANS##*[![:space:]]}"}"
	if [[ -z "$_ANS" ]]; then
		:
	elif [[ "$_ANS" = "0" || "$_ANS" = "off" || "$_ANS" = "-" ]]; then
		_ANS=""
	elif ! _valid_hostport "$_ANS"; then
		echo -e "\033[1;31mFormato inválido. Use host:puerto o 0 para quitar.\033[0m"
		_pause
		return 0
	fi
	DNS="$_ANS"
	_apply
	_applied_ok
}

_do_int_param() {
	# $1 var name  $2 label  $3 current
	local var="$1" label="$2" cur="$3"
	_load_conf
	clear
	echo -e "\033[1;32m$label\033[0m"
	echo ""
	_ask_keep "$label" "$cur"
	if ! _valid_int "$_ANS"; then
		echo -e "\033[1;31mDebe ser un entero positivo.\033[0m"
		_pause
		return 0
	fi
	eval "$var=\"\$_ANS\""
	_apply
	_applied_ok
}

_do_toggle() {
	# $1 var  $1 is 1 = enabled flag for the FEATURE as stored
	# For VERBOSE: 1 means on
	# For NO_LINUX_TUNE / NO_UVLOOP: 1 means the --no-* flag is set (feature OFF)
	local var="$1" label="$2" invert="$3"
	_load_conf
	local cur
	eval "cur=\$$var"
	clear
	if [[ "$invert" = "1" ]]; then
		echo -e "\033[1;32m$label\033[0m  (actual: $(_onoff "$([[ "$cur" = "1" ]] && echo 0 || echo 1)"))"
	else
		echo -e "\033[1;32m$label\033[0m  (actual: $(_onoff "$cur"))"
	fi
	echo -ne "\033[1;32mActivar? \033[1;33m[s/n]\033[1;32m: \033[1;37m"
	read -r ans
	ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
	local on=0
	[[ "$ans" = "s" || "$ans" = "si" || "$ans" = "y" || "$ans" = "1" ]] && on=1
	if [[ "$invert" = "1" ]]; then
		[[ "$on" = "1" ]] && eval "$var=0" || eval "$var=1"
	else
		eval "$var=$on"
	fi
	_apply
	_applied_ok
}

# ---------- menú ----------
while true; do
	clear
	_load_conf
	tput setaf 7
	tput setab 4
	tput bold
	printf '%34s%s%-10s\n' " Gestor UDPGW / udppy "
	tput sgr0
	echo ""
	echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	echo -e "\033[1;33m  Estado:   \033[1;37m$(_status_text)\033[0m"
	echo -e "\033[1;33m  Escucha:  \033[1;37m$LISTEN_ADDR\033[0m"
	echo -e "\033[1;33m  DNS:      \033[1;37m${DNS:-(off)}\033[0m"
	echo -e "\033[1;33m  UDP/cli:  \033[1;37m$MAX_CONNECTIONS\033[0m   \033[1;33mMTU:\033[1;37m $UDP_MTU\033[0m   \033[1;33mBacklog:\033[1;37m $BACKLOG\033[0m"
	echo -e "\033[1;33m  Verbose:  \033[1;37m$(_onoff "$VERBOSE")\033[0m  \033[1;33mLinux-tune:\033[1;37m $(_onoff "$([[ "$NO_LINUX_TUNE" = "1" ]] && echo 0 || echo 1)")\033[0m  \033[1;33muvloop:\033[1;37m $(_onoff "$([[ "$NO_UVLOOP" = "1" ]] && echo 0 || echo 1)")\033[0m"
	echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	echo ""
	echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m Instalar / actualizar udppy"
	echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m Iniciar"
	echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;33m Detener"
	echo -e "\033[1;31m[\033[1;36m4\033[1;31m]\033[1;33m Reiniciar"
	echo -e "\033[1;31m[\033[1;36m5\033[1;31m]\033[1;33m Estado y logs"
	echo ""
	echo -e "\033[1;31m[\033[1;36m6\033[1;31m]\033[1;33m Dirección de escucha (IP:puerto)"
	echo -e "\033[1;31m[\033[1;36m7\033[1;31m]\033[1;33m DNS (--dns)"
	echo -e "\033[1;31m[\033[1;36m8\033[1;31m]\033[1;33m Conexiones UDP por cliente"
	echo -e "\033[1;31m[\033[1;36m9\033[1;31m]\033[1;33m UDP MTU"
	echo -e "\033[1;31m[\033[1;36m10\033[1;31m]\033[1;33m Backlog TCP"
	echo -e "\033[1;31m[\033[1;36m11\033[1;31m]\033[1;33m Registro detallado (verbose)"
	echo -e "\033[1;31m[\033[1;36m12\033[1;31m]\033[1;33m Ajustes Linux (TCP_NODELAY / buffers)"
	echo -e "\033[1;31m[\033[1;36m13\033[1;31m]\033[1;33m uvloop"
	echo ""
	echo -e "\033[1;31m[\033[1;36m0\033[1;31m]\033[1;33m Volver"
	echo ""
	echo -ne "\033[1;32mOpción: \033[1;37m"
	read -r op
	case "$op" in
		1) _do_install ;;
		2) _do_start ;;
		3) _do_stop ;;
		4) _do_restart ;;
		5) _do_status ;;
		6) _do_listen ;;
		7) _do_dns ;;
		8) _do_int_param MAX_CONNECTIONS "Máx. conexiones UDP por cliente TCP" "$MAX_CONNECTIONS" ;;
		9) _do_int_param UDP_MTU "UDP MTU (payload máximo)" "$UDP_MTU" ;;
		10) _do_int_param BACKLOG "Backlog del socket TCP" "$BACKLOG" ;;
		11) _do_toggle VERBOSE "Registro detallado (--verbose)" 0 ;;
		12) _do_toggle NO_LINUX_TUNE "Ajustes Linux (TCP_NODELAY, buffers)" 1 ;;
		13) _do_toggle NO_UVLOOP "Usar uvloop (si está instalado)" 1 ;;
		0 | 00 | "") exit 0 ;;
		*)
			echo -e "\033[1;31mOpción no válida.\033[0m"
			sleep 1
			;;
	esac
done
